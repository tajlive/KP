{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",

  "regions": ["arn1"],
  "github": {
    "silent": true,
    "autoJobCanceling": true,
    "deploymentProtection": {
      "production": false,
      "preview": true
    }
  },
  "functions": {
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/v1/trading/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/webhooks/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/ai/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/health/**/*.ts": {
      "maxDuration": 10
    },
    "src/app/api/status/**/*.ts": {
      "maxDuration": 5
    },
    "src/app/api/stats/**/*.ts": {
      "maxDuration": 10
    },
    "src/app/api/test-*/**/*.ts": {
      "maxDuration": 10
    },
    "src/app/api/pricing/**/*.ts": {
      "maxDuration": 10
    },
    "src/app/api/v1/design-tokens/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/:locale/manifest.json",
      "destination": "/manifest.json"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!_next|api|auth|favicon|manifest|robots|sitemap).+)",
      "has": [
        {
          "type": "host",
          "value": "klarpakke.no"
        }
      ],
      "destination": "https://www.klarpakke.no/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/image/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/status",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(no|en)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(no|en)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 6 */5 * *"
    },
    {
      "path": "/api/cron/update-usdt-nok",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/feature-loader",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/ai-engine",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/ai-metrics",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/cron-health",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/tick",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/signal-health-selfcheck",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 6 * * *"
    }
  ],
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1",
      "NODE_OPTIONS": "--max-old-space-size=8192"
    }
  }
}
