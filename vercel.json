{
  "redirects": [
    {
      "source": "/:path((?!_next|api|static).*)",
      "has": [{ "type": "host", "value": "klarpakke.no" }],
      "destination": "https://www.klarpakke.no/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:locale(en|no)/manifest.json",
      "destination": "/manifest.json"
    }
  ]
}
