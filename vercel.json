{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "regions": ["arn1"],
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/daily-summary/route.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/:locale/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!_next|api|auth|favicon|manifest|robots|sitemap).+)",
      "has": [
        {
          "type": "host",
          "value": "klarpakke.no"
        }
      ],
      "destination": "https://www.klarpakke.no/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:locale((no|en))?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:locale((no|en))?/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 6 */5 * *"
    },
    {
      "path": "/api/cron/update-usdt-nok",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/cron/keepalive",
      "schedule": "0 6 */5 * *"
    },
    {
      "path": "/api/v1/cron/update-usdt-nok",
      "schedule": "0 6 * * *"
    }
  ]
}
