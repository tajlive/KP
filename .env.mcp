# 
# INSTRUKSJONER:
# 1. Kopier denne filen: cp .env.mcp .env.mcp.local
# 2. Fyll inn dine tokens (se MCP_AUTH_GUIDE.md)
# 3. Aldri commit .env.mcp.local til git!
#
# ═══════════════════════════════════════════════════════════════════════════

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VERCEL (https://vercel.com/account/tokens)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. Gå til: https://vercel.com/account/tokens
# 2. Klikk "Create Token"
# 3. Velg scope: "Full Account" eller kun team "tom-jensens-projects"
# 4. Kopier token og lim inn under:
VERCEL_TOKEN=your_vercel_token_here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SUPABASE (https://supabase.com/dashboard/account/tokens)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. Gå til: https://supabase.com/dashboard/account/tokens
# 2. Klikk "Generate new token"
# 3. Gi navn: "Klarpakke MCP"
# 4. Kopier token og lim inn under:
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_token_here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PROSJEKTREFERANSER (trengs for MCP URL-er)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SUPABASE_PROJECT_REF=pskhryjzkobytnfwucrb
VERCEL_TEAM_SLUG=tom-jensens-projects
VERCEL_PROJECT_SLUG=klarpakke
