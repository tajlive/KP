{
  "name": "klarpakke-universitet",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 246",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "check": "bash scripts/verify-production.sh",
    "check-mcp": "./scripts/mcp.sh check",
    "pre-commit": "npm run check-mcp && npm run lint && npm run type-check",
    "verify": "node scripts/verify-production.mjs",
    "launch": "bash scripts/launch-week2.sh",
    "deploy": "gcloud run deploy klarpakke --source . --region us-central1 --project klarpakke-universitet --allow-unauthenticated",
    "deploy:check": "curl -sI https://www.klarpakke.no | head -3",
    "prebuild": "node scripts/validate-i18n.js",
    "predeploy": "npm run type-check && npm run build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:jest": "jest",
    "test:jest:watch": "jest --watch",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright test --reporter=allure-playwright,line",
    "test:e2e:allure": "npm run test:e2e:report && npm run allure:generate",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:ci": "npm run test:e2e:allure && npm run allure:upload",
    "test:auth": "playwright test tests/e2e/auth.spec.ts",
    "test:auth:dev": "playwright test tests/e2e/auth.spec.ts --config=playwright.config.dev.ts",
    "test:auth:prod": "playwright test tests/e2e/auth.spec.ts --config=playwright.config.prod.ts",
    "test:ci": "jest --coverage && playwright test",
    "test:full": "npm run test:coverage && npm run test:e2e",
    "preview": "wrangler pages dev .open-next/worker",
    "vercel-build": "npm run build",
    "db:push": "supabase db push --linked",
    "db:status": "supabase migration list --linked",
    "db:diff": "supabase db diff --linked",
    "vercel:env": "vercel env pull .env.local",
    "vercel:deploy": "vercel --prod",
    "dev:full": "npm run vercel:env && npm run dev",
    "deploy:preview": "vercel",
    "deploy:prod": "vercel --prod",
    "deploy:prebuilt": "vercel build && vercel deploy --prebuilt --prod",
    "mcp:test": "scripts/mcp-test-runner.sh quick",
    "mcp:test:full": "scripts/mcp-test-runner.sh full",
    "mcp:integration": "scripts/mcp-integration-test.sh",
    "check:deps": "node scripts/check-missing-modules.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.39",
    "@ai-sdk/perplexity": "^3.0.18",
    "@ai-sdk/react": "^3.0.113",
