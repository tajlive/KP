{
  "name": "klarpakke-universitet",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 255",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ultimate": "playwright test --config=playwright.config.ultimate.ts",
    "test:ultimate:headed": "playwright test --config=playwright.config.ultimate.ts --headed",
    "test:ultimate:report": "playwright test --config=playwright.config.ultimate.ts && playwright show-report test-results/html",
    "test:all": "npm run test && npm run test:ultimate"
  }
}
