{
  "name": "klarpakke-universitet",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 255",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "check": "bash scripts/verify-production.sh",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:audit": "playwright test tests/comprehensive/full-site-audit.spec.ts",
    "test:audit:report": "playwright test tests/comprehensive/full-site-audit.spec.ts --reporter=html",
    "test:debug": "playwright test --debug",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  }
}
