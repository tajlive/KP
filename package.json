    "@tanstack/react-query-devtools": "^5.91.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^6.0.111",
    "binance-api-node": "^0.13.6",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
