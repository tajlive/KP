# Cloudflare Pages Redirects for Next.js App Router

# Redirect root to /no (default locale)
/ /no/ 302

# Handle locale roots - rewrite to index.html
/no/ /no/index.html 200
/en/ /en/index.html 200
/th/ /th/index.html 200
/zh/ /zh/index.html 200

# Handle trailing slashes for locales
/no /no/ 301
/en /en/ 301
/th /th/ 301
/zh /zh/ 301

# SPA fallback for client-side routing
/* /:splat.html 200
