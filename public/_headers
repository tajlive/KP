# ═══════════════════════════════════════════════════════════════
# CLOUDFLARE PAGES SECURITY HEADERS
# Klarpakke Universitet - Production Configuration
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# GLOBAL SECURITY HEADERS (All pages)
# ───────────────────────────────────────────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()
  Access-Control-Allow-Origin: *

# ───────────────────────────────────────────────────────────────
# HSTS - Strict Transport Security (1 year + preload)
# ───────────────────────────────────────────────────────────────
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# ───────────────────────────────────────────────────────────────
# CONTENT SECURITY POLICY - Norwegian locale
# ───────────────────────────────────────────────────────────────
/no/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://challenges.cloudflare.com https://*.tradingview.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://api.coingecko.com https://api.binance.com https://*.tradingview.com wss://*.supabase.co https://*.sanity.io wss://*.sanity.io https://www.google-analytics.com; frame-src https://challenges.cloudflare.com https://*.tradingview.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;

# ───────────────────────────────────────────────────────────────
# CONTENT SECURITY POLICY - English locale
# ───────────────────────────────────────────────────────────────
/en/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://challenges.cloudflare.com https://*.tradingview.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://api.coingecko.com https://api.binance.com https://*.tradingview.com wss://*.supabase.co https://*.sanity.io wss://*.sanity.io https://www.google-analytics.com; frame-src https://challenges.cloudflare.com https://*.tradingview.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;

# ───────────────────────────────────────────────────────────────
# STATIC ASSETS - Aggressive caching (1 year)
# ───────────────────────────────────────────────────────────────
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ───────────────────────────────────────────────────────────────
# RSC (React Server Components) - No caching
# ───────────────────────────────────────────────────────────────
/*.rsc
  Content-Type: text/x-component
  Cache-Control: public, max-age=0, must-revalidate

# ───────────────────────────────────────────────────────────────
# API ROUTES - No caching, security headers
# ───────────────────────────────────────────────────────────────
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
  Pragma: no-cache
  Expires: 0
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff

# ───────────────────────────────────────────────────────────────
# DYNAMIC PAGES - Private caching
# ───────────────────────────────────────────────────────────────
/no/dashboard/*
  Cache-Control: private, no-cache, no-store, must-revalidate

/en/dashboard/*
  Cache-Control: private, no-cache, no-store, must-revalidate

# ───────────────────────────────────────────────────────────────
# LEGAL PAGES - Long cache (changes rarely)
# ───────────────────────────────────────────────────────────────
/no/personvern
  Cache-Control: public, max-age=86400

/no/vilkar
  Cache-Control: public, max-age=86400

/en/personvern
  Cache-Control: public, max-age=86400

/en/vilkar
  Cache-Control: public, max-age=86400
