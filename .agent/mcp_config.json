{
  "_readme": "MCP-serverkonfigurasjon for Klarpakke. Kopier til ~/.gemini/antigravity/mcp_config.json for Antigravity (Gemini), eller tilsvarende for ditt verktøy.",
  "_masterPrompt": "Se .kimi/MASTER_PROMPT.md for fullstendig prosjektkontekst",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp", "--api-key", "YOUR_CONTEXT7_API_KEY"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest", "--access-token", "YOUR_SUPABASE_ACCESS_TOKEN"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PAT"
      }
    }
  }
}
