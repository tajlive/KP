{
  "_meta": {
    "version": "2.5",
    "project": "Klarpakke",
    "description": "KIMI CLI command aliases for Klarpakke — optimized 2026-05-15",
    "updated_for": "KIMI Code CLI 0.18.0 + MemPalace v3.4.0 + Skills roster 8"
  },
  "commands": {
    "health": {
      "description": "Sjekk produksjonshelse",
      "command": "npm run health:prod:gate"
    },
    "trading": {
      "description": "Aktiver trading engine skill",
      "command": "kimi --skills-dir .kimi/skills/klarpakke-trading"
    },
    "database": {
      "description": "Aktiver database & schema skill",
      "command": "kimi --skills-dir .kimi/skills/klarpakke-database"
    },
    "frontend": {
      "description": "Aktiver frontend & performance skill",
      "command": "kimi --skills-dir .kimi/skills/klarpakke-performance"
    },
    "testing": {
      "description": "Aktiver testing & QA skill",
      "command": "kimi --skills-dir .kimi/skills/klarpakke-testing"
    },
    "status": {
      "description": "Git status + prosjektstatus",
      "command": "git status && npm run verify 2>/dev/null || echo 'verify ikke tilgjengelig'"
    },
    "dev": {
      "description": "Start utviklingsserver",
      "command": "npm run dev"
    },
    "build": {
      "description": "Bygg prosjekt",
      "command": "npm run build"
    },
    "lint": {
      "description": "Kjør linter",
      "command": "npm run lint"
    },
    "typecheck": {
      "description": "TypeScript sjekk",
      "command": "npm run type-check"
    },
    "test": {
      "description": "Kjør unit tester",
      "command": "npm run test:unit"
    },
    "test:auth": {
      "description": "Kjør auth unit-tester",
      "command": "npm run test:unit -- src/lib/auth/__tests__"
    },
    "test:e2e": {
      "description": "Kjør E2E tester (critical)",
      "command": "npm run test:e2e:critical:chromium"
    },
    "test:smoke": {
      "description": "Kjør smoke E2E tester",
      "command": "npm run test:e2e:smoke"
    },
    "test:full": {
      "description": "Full test suite",
      "command": "npm run test:full"
    },
    "db:status": {
      "description": "Sjekk DB migrasjonsstatus",
      "command": "npm run db:status"
    },
    "db:push": {
      "description": "Push DB endringer",
      "command": "npm run db:push"
    },
    "db:gen": {
      "description": "Generer TypeScript typer fra DB",
      "command": "npm run db:gen-types"
    },
    "deploy": {
      "description": "Deploy til produksjon",
      "command": "npm run deploy:prod"
    },
    "preview": {
      "description": "Deploy til preview/staging (Fly.io)",
      "command": "flyctl deploy --remote-only --app klarpakke-staging"
    },
    "fly:status": {
      "description": "Sjekk Fly.io app-status",
      "command": "flyctl status --app klarpakke"
    },
    "fly:logs": {
      "description": "Se Fly.io logs",
      "command": "flyctl logs --app klarpakke"
    },
    "prod": {
      "description": "Full prod pipeline (lint, test, db, monitor, deploy, monitor)",
      "command": "bash /Users/taj/klarpakke/.kimi/prod-deploy.sh"
    },
    "prod:preview": {
      "description": "Full pipeline mot preview",
      "command": "bash /Users/taj/klarpakke/.kimi/prod-deploy.sh --preview"
    },
    "ci": {
      "description": "Lint + unit tests",
      "command": "npm run lint:gate && npm run test:unit"
    },
    "monitor": {
      "description": "Sjekk produksjonshelse",
      "command": "curl -s https://www.klarpakke.no/api/health | jq -r '.status' || echo 'unreachable'"
    },
    "mcp:check": {
      "description": "Verifiser alle MCP-tilkoblinger",
      "command": "node scripts/mcp-smoke-test.mjs"
    },
    "mcp:list": {
      "description": "List MCP-servere i repo-konfigurasjonen",
      "command": "node --input-type=module -e \"import { readFileSync } from 'node:fs'; const cfg = JSON.parse(readFileSync('.mcp/mcp_config.json','utf8')); console.log(Object.keys(cfg.mcpServers || {}).join('\\\\n'))\""
    },
    "watchdog": {
      "description": "Kjør watchdog sjekk",
      "command": "npm run test:watchdog 2>/dev/null || bash scripts/hourly-external-user-watchdog.sh"
    },
    "auth": {
      "description": "Aktiver auth-spesialisert KIMI-skill med full MCP",
      "command": "kimi --skills-dir .kimi/skills/klarpakke-auth"
    },
    "architect": {
      "description": "Aktiver lead architect skill for Klarpakke",
      "command": "kimi --skills-dir .kimi/skills/klarpakke-architect"
    },
    "super": {
      "description": "Aktiver super-skill med full smart-launch + pre-session kontekst + post-session analyse",
      "command": "kimi --skills-dir .kimi/skills/klarpakke-super"
    },
    "sanity:token": {
      "description": "Hjelp til å generere Sanity API-tokens",
      "command": "echo 'Generer tokens på: https://www.sanity.io/manage/project/63qn23si/api' && echo '1. Klikk Tokens → Add API token' && echo '2. Viewer role for read, Editor role for write' && echo '3. Kopier token til .env.local som SANITY_API_READ_TOKEN / SANITY_API_WRITE_TOKEN'"
    },
    "mempalace": {
      "description": "Aktiver MemPalace memory-arkitekt skill (k2.6-optimalisert)",
      "command": "kimi --skills-dir .kimi/skills/klarpakke-mempalace"
    },
    "plan": {
      "description": "Lag en arkitekt-plan for en oppgave",
      "command": "bash .kimi/AGENT_ORCHESTRATOR.sh plan"
    },
    "swarm:review": {
      "description": "Kjør full swarm QA på git diff",
      "command": "npm run swarm:review"
    },
    "swarm:security": {
      "description": "Kjør security-fokusert swarm QA",
      "command": "npm run swarm:security"
    },
    "skills": {
      "description": "Vis skills-activation mapping",
      "command": "cat .kimi/skills-activation.yaml | head -40"
    },
    "trading:metrics": {
      "description": "Hent trading metrics (siste 24h)",
      "command": "node scripts/monitor/trading-metrics.mjs 24"
    },
    "trading:baseline": {
      "description": "Vis baseline for 48h observasjon",
      "command": "cat scripts/monitor/baseline.json | jq ."
    },
    "trading:compare": {
      "description": "Sammenlign baseline med nåværende metrics",
      "command": "node scripts/monitor/trading-metrics.mjs 24 --save=/tmp/current-metrics.json && python3 scripts/monitor/compare-metrics.py scripts/monitor/baseline.json /tmp/current-metrics.json"
    },
    "trading:decision": {
      "description": "Kjør rollout decision engine",
      "command": "node scripts/monitor/trading-metrics.mjs 48 --save=/tmp/final-metrics.json && python3 scripts/monitor/rollout-decision.py scripts/monitor/baseline.json /tmp/final-metrics.json"
    }
  }
}