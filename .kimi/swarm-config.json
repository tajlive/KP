{
  "name": "Klarpakke Swarm",
  "version": "2.1.0",
  "description": "Multi-agent swarm for world-class quality",
  "platform": "darwin-arm64",
  "swarm": {
    "coordinator": "kimi",
    "agents": [
      {
        "id": "analyzer",
        "name": "Code Analyzer",
        "trigger": "pre-task",
        "specialty": "AST analysis, complexity detection",
        "prompt_file": ".kimi/swarm/analyzer.md"
      },
      {
        "id": "architect",
        "name": "Architecture Guardian",
        "trigger": "on-decision",
        "specialty": "ADR compliance, pattern enforcement",
        "prompt_file": ".kimi/swarm/architect.md"
      },
      {
        "id": "tester",
        "name": "Test Strategist",
        "trigger": "post-implementation",
        "specialty": "Test coverage, edge cases",
        "prompt_file": ".kimi/swarm/tester.md"
      },
      {
        "id": "security",
        "name": "Security Auditor",
        "trigger": "on-security-path",
        "specialty": "RLS, secrets, auth",
        "prompt_file": ".kimi/swarm/security.md"
      },
      {
        "id": "knowledge",
        "name": "Knowledge Keeper",
        "trigger": "post-task",
        "model": "kimi-code/kimi-for-coding",
        "context_window": 262144,
        "specialty": "MemPalace sync, decision logging, KG maintenance",
        "prompt_file": ".kimi/swarm/knowledge.md",
        "mcp_profile": "minimal",
        "mempalace_tools": ["search", "kg_batch", "write_diary", "auto_tag"]
      }
    ],
    "workflows": {
      "feature": ["analyzer", "architect", "tester", "security", "knowledge"],
      "bugfix": ["analyzer", "tester", "security", "knowledge"],
      "refactor": ["analyzer", "architect", "tester", "security", "knowledge"],
      "security": ["security", "analyzer", "tester", "knowledge"],
      "architect": ["architect", "analyzer", "knowledge"],
      "review": ["analyzer", "architect", "tester", "security", "knowledge"]
    },
    "routing_rules": [
      {
        "id": "deploy",
        "name": "Deploy & Infrastructure",
        "agent": "klarpakke-architect-agent.yaml",
        "file_patterns": ["fly.toml", "scripts/fly-*.mjs", "scripts/cf-*.mjs", "scripts/cloudflare-*.mjs", ".github/workflows/deploy-*.yml", "next.config.*"],
        "trigger": "git-diff-match"
      },
      {
        "id": "trading",
        "name": "Trading Engine",
        "agent": "klarpakke-trading-engine-agent.yaml",
        "file_patterns": ["src/lib/trading/", "src/lib/auto-trading/", "supabase/migrations/.*trading", "supabase/migrations/.*bot", "supabase/migrations/.*cron"],
        "trigger": "git-diff-match"
      },
      {
        "id": "database",
        "name": "Database",
        "agent": "klarpakke-database-agent.yaml",
        "file_patterns": ["supabase/migrations/.*\\.sql", "src/lib/supabase/"],
        "trigger": "git-diff-match"
      },
      {
        "id": "performance",
        "name": "Performance",
        "agent": "klarpakke-performance-agent.yaml",
        "file_patterns": ["src/app/.*page\\.tsx", "src/components/.*\\.tsx", "next.config", "tailwind.config"],
        "trigger": "git-diff-match"
      },
      {
        "id": "auth",
        "name": "Auth & Security",
        "agent": "auth-agent.yaml",
        "file_patterns": ["src/lib/auth/", "src/app/api/auth", "src/middleware.*auth", "src/app/.*login", "src/app/.*register"],
        "trigger": "git-diff-match"
      },
      {
        "id": "cms",
        "name": "Sanity CMS",
        "agent": "sanity-agent.yaml",
        "file_patterns": ["src/sanity/", "sanity.config", "src/app/api/webhooks/sanity"],
        "trigger": "git-diff-match"
      }
    ]
  },
  "quality_gates": {
    "min_test_coverage": 60,
    "max_complexity": 15,
    "max_file_lines": 2000,
    "max_file_lines_exceptions": ["scripts/*-mcp-*.mjs", "scripts/*-mcp-*.ts"],
    "require_adr": true,
    "require_adr_exemptions": ["bugfix", "hotfix"],
    "require_adr_max_files": 5,
    "require_docs": true
  },
  "mem_palace": {
    "sync_on_complete": true,
    "extract_decisions": true,
    "extract_patterns": true,
    "extract_errors": true
  }
}
