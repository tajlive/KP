{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@0.20.3", "--no-usage-statistics"]
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "context7": {
      "command": "node",
      "args": ["scripts/run-context7-mcp.mjs"]
    },
    "filesystem": {
      "command": "node",
      "args": ["scripts/run-filesystem-mcp.mjs"]
    },
    "github": {
      "command": "node",
      "args": ["scripts/run-github-mcp.mjs"]
    },
    "klarpakke-remote-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.1.38",
        "https://vuxbjlykgmzskxbclquf.supabase.co/functions/v1/klarpakke-mcp/mcp",
        "--header",
        "Authorization: Bearer ${KLARPAKKE_MCP_TOKEN}"
      ]
    },
    "linear": {
      "command": "node",
      "args": ["scripts/run-linear-mcp.mjs"]
    },
    "perplexity": {
      "command": "node",
      "args": ["scripts/run-perplexity-mcp.mjs"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "resend": {
      "command": "npx",
      "args": ["-y", "resend-mcp@2.2.0"],
      "env": {
        "RESEND_API_KEY": "${RESEND_API_KEY}"
      }
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server@0.30.0"],
      "env": {
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "SENTRY_ORG": "${SENTRY_ORG}"
      }
    },
    "stripe": {
      "command": "npx",
      "args": ["-y", "@stripe/agent-toolkit@0.9.0"],
      "env": {
        "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY}"
      }
    },
    "supabase": {
      "command": "node",
      "args": ["scripts/run-official-supabase-mcp.mjs"]
    },
    "supabase-db": {
      "command": "node",
      "args": ["scripts/run-supabase-mcp.mjs"]
    },
    "vercel": {
      "command": "node",
      "args": ["scripts/run-vercel-mcp.mjs"]
    },
    "vipps": {
      "command": "node",
      "args": ["scripts/run-vipps-mcp.mjs"]
    }
  }
}
