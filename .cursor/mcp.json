{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "linear": {
      "command": "node",
      "args": [
        "scripts/run-linear-mcp.mjs"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "${SUPABASE_ACCESS_TOKEN}",
        "--project-ref",
        "vuxbjlykgmzskxbclquf"
      ]
    },
    "supabase-db": {
      "command": "node",
      "args": ["scripts/run-supabase-mcp.mjs"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "resend": {
      "command": "npx",
      "args": [
        "-y",
        "resend-mcp@latest"
      ],
      "env": {
        "RESEND_API_KEY": "${RESEND_API_KEY}"
      }
    },
    "vipps": {
      "command": "node",
      "args": ["scripts/run-vipps-mcp.mjs"]
    }
  }
}