# ═══════════════════════════════════════════════════════════════
# KLARPAKKE — Launch Day Deployment Environment
# Kopier til .env.deploy og fyll inn verdier
# ═══════════════════════════════════════════════════════════════

# ═══ SUPABASE ═══════════════════════════════════════════════════
# Project ref fra Supabase Dashboard → Settings → General
PROD_REF=pskhryjzkobytnfwucrb

# Access Token fra https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxx

# Service Role Key (fra Dashboard → Settings → API)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ═══ STRIPE ═════════════════════════════════════════════════════
# Live secret key (ikke test!)
STRIPE_SECRET_KEY=sk_live_...

# Webhook secret fra Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ═══ RESEND ═════════════════════════════════════════════════════
# API key fra https://resend.com/api-keys
RESEND_API_KEY=re_...

# ═══ SLACK ══════════════════════════════════════════════════════
# Webhook URL fra Slack App → Incoming Webhooks
SLACK_OPS_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ═══ SENTRY ═════════════════════════════════════════════════════
# Auth token fra https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=sntryu_...

# ═══ VERCEL ═════════════════════════════════════════════════════
# Token fra https://vercel.com/account/tokens
VERCEL_TOKEN=vercel-token-xxx

# ═══ GENERERT ═══════════════════════════════════════════════════
# Generer med: openssl rand -hex 32
CRON_SECRET=change-this-to-64-char-hex-string

# ═══ OPTIONAL ═══════════════════════════════════════════════════
# For manuell testing
SUPABASE_ANON_KEY=eyJ...
GITHUB_TOKEN=ghp_...


# ═══ CLOUDFLARE ═══════════════════════════════════════════════════
# API token: needs Workers Scripts Edit, Zone Workers Routes Edit,
# Workers KV Edit, Zone Cache Purge Edit, Zone Read.
# CLOUDFLARE_API_TOKEN=your-token
# CLOUDFLARE_ACCOUNT_ID=80d5b1d56a3e907150ba7348b6182894
# CLOUDFLARE_ZONE_ID=328d7de7e8e48308fd4f9d760da5b18f

# ═══ BRUK ═══════════════════════════════════════════════════════
# 1. Kopier denne filen:
#    cp .env.deploy.template .env.deploy
#
# 2. Fyll inn alle verdier
#
# 3. Last inn:
#    source .env.deploy
#
# 4. Verifiser:
#    echo $PROD_REF
#
# 5. Kjør deployment:
#    ./scripts/launch-day-deploy.sh pre
#    ./scripts/launch-day-deploy.sh deploy
#    ./scripts/launch-day-deploy.sh verify
