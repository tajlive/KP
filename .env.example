# ==========================================
# Klarpakke - Miljøvariabler
# ==========================================

# ------------------------------------------
# AI PROVIDERS (minst en påkrevd)
# ------------------------------------------

# Perplexity PRO (Anbefalt - primær provider)
# Få API-nøkkel fra: https://perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# KIMI (Moonshot AI) - Fallback
# Få API-nøkkel fra: https://platform.moonshot.cn/
MOONSHOT_API_KEY=your_moonshot_api_key_here
# eller
KIMI_API_KEY=your_kimi_api_key_here

# NVIDIA NIM - Fallback
# Få API-nøkkel fra: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
# eller
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# OpenAI - Optional (for visse features)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------
# SUPABASE (påkrevd)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ------------------------------------------
# STRIPE (påkrevd for betaling)
# ------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------
# BINANCE (for trading)
# ------------------------------------------
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Paper trading: USDT -> NOK rate (optional; fallback ~10.8). Set via cron for production.
# USDT_NOK_RATE=10.8

# ------------------------------------------
# RESEND (for e-post)
# ------------------------------------------
RESEND_API_KEY=re_...

# ------------------------------------------
# CRON (for scheduled jobs)
# ------------------------------------------
CRON_SECRET=your_cron_secret

# ------------------------------------------
# NEXTAUTH (for autentisering)
# ------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# ------------------------------------------
# VERCEL (auto-generert)
# ------------------------------------------
VERCEL_OIDC_TOKEN=...

# ------------------------------------------
# E2E TEST CONFIGURATION (optional)
# ------------------------------------------
BASE_URL=https://www.klarpakke.no

# Test user credentials (for automated E2E tests)
TEST_USER_EMAIL=klarpakke.test+playwright@gmail.com
TEST_USER_PASSWORD=your_test_password_here

# Secondary test user (for security tests)
TEST_USER_B_EMAIL=klarpakke.test+b@gmail.com
TEST_USER_B_PASSWORD=your_test_password_here

# Admin credentials (for admin tests)
TEST_ADMIN_EMAIL=admin@klarpakke.no
TEST_ADMIN_PASSWORD=your_admin_password_here
