# ============================================
# STRIPE KONFIGURASJON
# ============================================

# -------------------------------------------------
# TEST MODE (Bruk disse under utvikling)
# -------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Test priser (fra Stripe Dashboard Test Mode)
NEXT_PUBLIC_PRICE_CRYPTO_COURSE_TEST=price_test_xxx
NEXT_PUBLIC_PRICE_TRADING_COURSE_TEST=price_test_xxx
NEXT_PUBLIC_PRICE_CRYPTO_SUB_TEST=price_test_xxx
NEXT_PUBLIC_PRICE_TRADING_SUB_TEST=price_test_xxx
NEXT_PUBLIC_PRICE_VIP_BASIC_TEST=price_test_xxx
NEXT_PUBLIC_PRICE_VIP_PRO_TEST=price_test_xxx
NEXT_PUBLIC_PRICE_VIP_EXTREME_TEST=price_test_xxx

# -------------------------------------------------
# LIVE MODE (Kun for produksjon!)
# -------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE
# STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_HERE
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Live priser (fra Stripe Dashboard Live Mode)
# NEXT_PUBLIC_PRICE_CRYPTO_COURSE=price_live_xxx
# NEXT_PUBLIC_PRICE_TRADING_COURSE=price_live_xxx
# NEXT_PUBLIC_PRICE_CRYPTO_SUB=price_live_xxx
# NEXT_PUBLIC_PRICE_TRADING_SUB=price_live_xxx
# NEXT_PUBLIC_PRICE_VIP_BASIC=price_live_xxx
# NEXT_PUBLIC_PRICE_VIP_PRO=price_live_xxx
# NEXT_PUBLIC_PRICE_VIP_EXTREME=price_live_xxx

# ============================================
# ANDRE INNSTILLINGER
# ============================================

# Domene (for webhooks)
NEXT_PUBLIC_DOMAIN=http://localhost:3000
# NEXT_PUBLIC_DOMAIN=https://www.klarpakke.no

# Skatt (MVA) - Settes opp i Stripe Dashboard
# MVA rate ID: txr_xxxxxxxxxxxxx
