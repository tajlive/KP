# Supabase (hent fra https://supabase.com/dashboard/project/pskhryjzkobytnfwucrb/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://pskhryjzkobytnfwucrb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...YOUR_ANON_KEY_HERE

# Supabase Service Role (HEMMELIG - kun for server-side/migrations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...YOUR_SERVICE_ROLE_KEY_HERE

# Database / Supabase Supavisor pooler
# VIKTIG: POSTGRES_URL MÅ inneholde options=reference%3D<project-ref> for at
# Supavisor skal vite hvilket prosjekt/tenant den skal koble til.
# Uten denne parameteren får du feil som:
#   "tenant/user postgres.pskhryjzkobytnfwucrb not found"
# Bytt ut [PASSWORD] med ditt faktiske databasepassord.
POSTGRES_URL=postgresql://postgres.pskhryjzkobytnfwucrb:[PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?options=reference%3Dpskhryjzkobytnfwucrb
DATABASE_URL=${POSTGRES_URL}

# Stripe (hent fra https://dashboard.stripe.com/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...YOUR_PUBLISHABLE_KEY_HERE
STRIPE_SECRET_KEY=sk_test_...YOUR_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_...YOUR_WEBHOOK_SECRET_HERE

# Cloudflare (valgfritt - kun hvis du deployer manuelt)
CLOUDFLARE_API_TOKEN=YOUR_TOKEN_HERE
CLOUDFLARE_ZONE_ID=YOUR_ZONE_ID_HERE
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID_HERE

# Resend (email - valgfritt)
RESEND_API_KEY=re_...YOUR_RESEND_KEY_HERE

# Caching / Risk State (Upstash Redis REST — preferred)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Legacy alias for Upstash Redis (fallback if above are not set)
KV_REST_API_URL=https://xxx.upstash.io
KV_REST_API_TOKEN=xxx

# Binance WebSocket (Optional for faster updates)
NEXT_PUBLIC_BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ⚠️ VIKTIG NOTIS:
# 1. ALDRI commit denne filen med reelle verdier!
# 2. Kopier til .env.local og fyll inn reelle verdier der
# 3. .env.local er i .gitignore og blir IKKE committet
# 4. For produksjon: Sett variabler i Cloudflare Dashboard og GitHub Secrets
