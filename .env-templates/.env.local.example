# ============================================================
# KLARPAKKE - ENVIRONMENT VARIABLES
# Kopier denne filen til .env.local og fyll inn verdier
# ============================================================

# ============================================================
# SUPABASE (Påkrevd)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# STRIPE BETALING (Påkrevd for betaling)
# ============================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs fra Stripe Dashboard
STRIPE_STUDENT_PRICE_ID=price_...
STRIPE_MASTER_PRICE_ID=price_...
STRIPE_PROFESSOR_PRICE_ID=price_...

# ============================================================
# PWA & PUSH NOTIFICATIONS (Påkrevd for push)
# ============================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BJxxxxx...
VAPID_PRIVATE_KEY=xxxxx...

# ============================================================
# SITE CONFIG
# ============================================================
NEXT_PUBLIC_SITE_URL=https://www.klarpakke.no

# ============================================================
# CLOUDFLARE (Påkrevd for deploy + cache purge)
# ============================================================
# Cloudflare API token. Needs: Workers Scripts Edit, Zone Workers Routes Edit,
# Workers KV Edit, Zone Cache Purge Edit, Zone Read.
# CLOUDFLARE_API_TOKEN=your-token
# CLOUDFLARE_ACCOUNT_ID=80d5b1d56a3e907150ba7348b6182894
# CLOUDFLARE_ZONE_ID=328d7de7e8e48308fd4f9d760da5b18f

# ============================================================
# EMAIL (Valgfritt - for magic link auth)
# ============================================================
EMAIL_SERVER=smtp://user:pass@host:port
FROM_EMAIL=no-reply@klarpakke.no
RESEND_API_KEY=re_...

# ============================================================
# SENTRY ERROR TRACKING (Valgfritt)
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ============================================================
# MOONSHOT AI (KIMI) - Valgfritt for AI chat
# Hent API key fra: https://platform.moonshot.cn/
# ============================================================
MOONSHOT_API_KEY=sk-...

# ============================================================
# GOOGLE OAUTH (Valgfritt - hvis du vil teste Google login lokalt)
# NOTE: I produksjon konfigureres dette i Supabase Dashboard
# ============================================================
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ============================================================
# APPLE OAUTH (Valgfritt)
# ============================================================
APPLE_CLIENT_ID=com.klarpakke.app
APPLE_KEY_ID=xxx
APPLE_PRIVATE_KEY="<sett inn Apple private key (PKCS8 PEM) fra Apple Developer Portal — ALDRI commit>"

# ============================================================
# CHROME CONTROL MCP (Valgfritt - for lokal browser-automasjon)
# ============================================================
# API-nøkkel brukt av MCP wrapper-scripts (kreves for chrome-serveren)
# MCP_API_KEY=your-mcp-api-key

# Komma-separert liste over tillatte domener for chrome_navigate
# CHROME_MCP_ALLOWLIST=klarpakke.no,www.klarpakke.no

# Standard profil-modus for chrome_start: clean | copy | cdp | storage
# CHROME_MCP_PROFILE_MODE=clean

# CDP-endepunkt når profileMode er 'cdp'
# CHROME_CDP_URL=http://127.0.0.1:9222

# ============================================================
# DEVELOPMENT
# ============================================================
NODE_ENV=development

# ============================================================
# DARK FLEET AI/ML TRADING (Valgfritt - gradvis rollout)
# ============================================================
# Master switch - må være "true" for å aktivere Dark Fleet
ENABLE_DARK_FLEET=false

# Prosentandel av brukere som får Dark Fleet (0-100)
# Start med 0, øk gradvis: 1 → 5 → 20 → 50 → 100
DARK_FLEET_CHALLENGER_PERCENT=0

# Salt for deterministisk bruker-tildeling (endre for ny runde)
DARK_FLEET_ROLLOUT_SALT=klarpakke-dark-fleet-2026

# Ensemble threshold (0.0-1.0) - høyere = færre trades
DARK_FLEET_THRESHOLD=0.3

# Maks position size (0.0-1.0) - f.eks. 0.12 = 12%
DARK_FLEET_MAX_POSITION=0.12

# Beta test brukere (komma-separert user IDs)
# Disse får beta guardrails (daily P&L cap, drawdown limits)
BETA_USER_IDS=
