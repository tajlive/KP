# ============================================================
# PWA & PUSH NOTIFICATIONS
# Kopier til .env.local og fyll inn verdiene
# ============================================================

# Generate VAPID keys with:
# npx web-push generate-vapid-keys
#
# Or use this command:
# npm install -g web-push
# web-push generate-vapid-keys

NEXT_PUBLIC_VAPID_PUBLIC_KEY=BJxxxxx...
VAPID_PRIVATE_KEY=xxxxx...

# Site URL (for PWA manifest and service worker)
NEXT_PUBLIC_SITE_URL=https://klarpakke.no

# Supabase Service Role Key (for push subscription storage)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
