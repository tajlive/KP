{
  "imports": {
    "std/": "https://deno.land/std@0.224.0/",
    "supabase": "https://esm.sh/@supabase/functions-js@2.3.0"
  },
  "tasks": {
    "start": "deno run --allow-all --unstable supabase/functions/hello-world/index.ts"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["node_modules", ".git"]
  },
  "fmt": {
    "exclude": ["node_modules", ".git"],
    "semiColons": true,
    "singleQuote": false,
    "useTabs": false,
    "lineWidth": 100
  }
}
