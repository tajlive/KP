],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/debug/paper-balance-trace.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/fixtures/auth-fixtures.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/fixtures/selectors.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/fixtures/test-data.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/fixtures/test-users.ts","messages":[{"ruleId":"no-redeclare","severity":2,"message":"'getTestUser' is already defined.","line":202,"column":17,"nodeType":"Identifier","messageId":"redeclared","endLine":202,"endColumn":28},{"ruleId":"no-redeclare","severity":2,"message":"'getTestUser' is already defined.","line":203,"column":17,"nodeType":"Identifier","messageId":"redeclared","endLine":203,"endColumn":28},{"ruleId":"no-redeclare","severity":2,"message":"'getTestUser' is already defined.","line":207,"column":17,"nodeType":"Identifier","messageId":"redeclared","endLine":207,"endColumn":28},{"ruleId":"no-redeclare","severity":2,"message":"'getTestUser' is already defined.","line":211,"column":17,"nodeType":"Identifier","messageId":"redeclared","endLine":211,"endColumn":28}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Test User Definitions for E2E Testing\n * \n * Test users for different scenarios:\n * - Tier-based users (student, bachelor, master, phd, professor)\n * - Trading session users (with/without paper trading sessions)\n * - Notification users (with/without push subscriptions)\n * \n * These users should be created via scripts/create-test-users.js\n */\n\nexport type UserTier = \"student\" | \"bachelor\" | \"master\" | \"phd\" | \"professor\";\nexport type UserType = \"primary\" | \"tier\" | \"trading\" | \"notifications\";\n\nexport interface TestUser {\n  email: string;\n  password: string;\n  displayName: string;\n  tier: UserTier;\n  description: string;\n  features: {\n    hasTradingSession: boolean;\n    hasNotifications: boolean;\n    isVerified: boolean;\n  };\n}\n\n/**\n * Primary E2E test user - the main user for most tests\n */\nexport const PRIMARY_TEST_USER: TestUser = {\n  email: \"tom@klarpakke.no\",\n  password: \"TestPassword123!\",\n  displayName: \"E2E Test User\",\n  tier: \"student\",\n  description: \"Primary E2E test user - standard student tier\",\n  features: {\n    hasTradingSession: false,\n    hasNotifications: false,\n    isVerified: true,\n  },\n};\n\n/**\n * Test users for each pricing tier\n */\nexport const TIER_TEST_USERS: Record<UserTier, TestUser> = {\n  student: {\n    email: \"e2e.student@klarpakke.test\",\n    password: \"TestPassword123!\",\n    displayName: \"E2E Student User\",\n    tier: \"student\",\n    description: \"Student tier - entry level\",\n    features: {\n      hasTradingSession: false,\n      hasNotifications: false,\n      isVerified: true,\n    },\n  },\n  bachelor: {\n    email: \"e2e.bachelor@klarpakke.test\",\n    password: \"TestPassword123!\",\n    displayName: \"E2E Bachelor User\",\n    tier: \"bachelor\",\n    description: \"Bachelor tier - basic features\",\n    features: {\n      hasTradingSession: true,\n      hasNotifications: false,\n      isVerified: true,\n    },\n  },\n  master: {\n    email: \"e2e.master@klarpakke.test\",\n    password: \"TestPassword123!\",\n    displayName: \"E2E Master User\",\n    tier: \"master\",\n    description: \"Master tier - advanced features\",\n    features: {\n      hasTradingSession: true,\n      hasNotifications: true,\n      isVerified: true,\n    },\n  },\n  phd: {\n    email: \"e2e.phd@klarpakke.test\",\n    password: \"TestPassword123!\",\n    displayName: \"E2E PhD User\",\n    tier: \"phd\",\n    description: \"PhD tier - professional features\",\n    features: {\n      hasTradingSession: true,\n      hasNotifications: true,\n      isVerified: true,\n    },\n  },\n  professor: {\n    email: \"e2e.professor@klarpakke.test\",\n    password: \"TestPassword123!\",\n    displayName: \"E2E Professor User\",\n    tier: \"professor\",\n    description: \"Professor tier - all features\",\n    features: {\n      hasTradingSession: true,\n      hasNotifications: true,\n      isVerified: true,\n    },\n  },\n};\n\n/**\n * Test users for trading scenarios\n */\nexport const TRADING_TEST_USERS = {\n  withSession: {\n    email: \"e2e.trading.active@klarpakke.test\",\n    password: \"TestPassword123!\",\n    displayName: \"E2E Active Trader\",\n    tier: \"master\" as UserTier,\n    description: \"User with active paper trading session\",\n    features: {\n      hasTradingSession: true,\n      hasNotifications: false,\n      isVerified: true,\n    },\n  },\n  withoutSession: {\n    email: \"e2e.trading.new@klarpakke.test\",\n    password: \"TestPassword123!\",\n    displayName: \"E2E New Trader\",\n    tier: \"bachelor\" as UserTier,\n    description: \"User without any trading session\",\n    features: {\n      hasTradingSession: false,\n      hasNotifications: false,\n      isVerified: true,\n    },\n  },\n  withTradeHistory: {\n    email: \"e2e.trading.history@klarpakke.test\",\n    password: \"TestPassword123!\",\n    displayName: \"E2E Trader with History\",\n    tier: \"phd\" as UserTier,\n    description: \"User with trade history in paper trading\",\n    features: {\n      hasTradingSession: true,\n      hasNotifications: false,\n      isVerified: true,\n    },\n  },\n};\n\n/**\n * Test users for notification scenarios\n */\nexport const NOTIFICATION_TEST_USERS = {\n  withSubscription: {\n    email: \"e2e.notif.subscribed@klarpakke.test\",\n    password: \"TestPassword123!\",\n    displayName: \"E2E Subscribed User\",\n    tier: \"master\" as UserTier,\n    description: \"User with push notification subscription\",\n    features: {\n      hasTradingSession: true,\n      hasNotifications: true,\n      isVerified: true,\n    },\n  },\n  withoutSubscription: {\n    email: \"e2e.notif.unsubscribed@klarpakke.test\",\n    password: \"TestPassword123!\",\n    displayName: \"E2E Unsubscribed User\",\n    tier: \"bachelor\" as UserTier,\n    description: \"User without push notification subscription\",\n    features: {\n      hasTradingSession: true,\n      hasNotifications: false,\n      isVerified: true,\n    },\n  },\n};\n\n/**\n * Legacy test users (for backward compatibility)\n */\nexport const LEGACY_TEST_USERS = [\n  {\n    email: \"klarpakke.test+playwright@gmail.com\",\n    password: \"bilglass123\",\n    displayName: \"Test User A\",\n  },\n  {\n    email: \"klarpakke.test+b@gmail.com\",\n    password: \"bilglass123\",\n    displayName: \"Test User B\",\n  },\n];\n\n/**\n * Get test user by type and identifier\n */\nexport function getTestUser(type: \"primary\", identifier?: never): TestUser;\nexport function getTestUser(type: \"tier\", tier: UserTier): TestUser;\nexport function getTestUser(\n  type: \"trading\",\n  variant: \"withSession\" | \"withoutSession\" | \"withTradeHistory\"\n): TestUser;\nexport function getTestUser(\n  type: \"notifications\",\n  variant: \"withSubscription\" | \"withoutSubscription\"\n): TestUser;\nexport function getTestUser(\n  type: UserType,\n  identifier?: string\n): TestUser | undefined {\n  switch (type) {\n    case \"primary\":\n      return PRIMARY_TEST_USER;\n    case \"tier\":\n      return identifier ? TIER_TEST_USERS[identifier as UserTier] : undefined;\n    case \"trading\":\n      return identifier\n        ? TRADING_TEST_USERS[identifier as keyof typeof TRADING_TEST_USERS]\n        : undefined;\n    case \"notifications\":\n      return identifier\n        ? NOTIFICATION_TEST_USERS[identifier as keyof typeof NOTIFICATION_TEST_USERS]\n        : undefined;\n    default:\n      return undefined;\n  }\n}\n\n/**\n * All test users for provisioning\n */\nexport const ALL_TEST_USERS: TestUser[] = [\n  PRIMARY_TEST_USER,\n  ...Object.values(TIER_TEST_USERS),\n  ...Object.values(TRADING_TEST_USERS),\n  ...Object.values(NOTIFICATION_TEST_USERS),\n];\n\n/**\n * Get credentials from environment variables\n */\nexport function getEnvCredentials(): { email: string; password: string } | null {\n  const email =\n    process.env.E2E_USER_EMAIL || process.env.TEST_USER_EMAIL;\n  const password =\n    process.env.E2E_USER_PASSWORD || process.env.TEST_USER_PASSWORD;\n\n  if (email && password) {\n    return { email, password };\n  }\n\n  return null;\n}\n\n/**\n * Get primary test user (fallback to env credentials)\n */\nexport function getPrimaryTestUser(): TestUser {\n  const envCreds = getEnvCredentials();\n  \n  if (envCreds) {\n    return {\n      ...PRIMARY_TEST_USER,\n      email: envCreds.email,\n      password: envCreds.password,\n    };\n  }\n\n  return PRIMARY_TEST_USER;\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/helpers/auth.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/helpers/i18n-guard.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/helpers/supabase-cookies.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/helpers/wait-for-dev-health.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/landing/conversion.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/mobile/critical-journey.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/mobile/responsive.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/performance/lighthouse.spec.ts","messages":[{"ruleId":"no-undef","severity":2,"message":"'PerformanceEntry' is not defined.","line":50,"column":84,"nodeType":"Identifier","messageId":"undef","endLine":50,"endColumn":100},{"ruleId":"no-undef","severity":2,"message":"'PerformanceEntry' is not defined.","line":65,"column":69,"nodeType":"Identifier","messageId":"undef","endLine":65,"endColumn":85},{"ruleId":"no-undef","severity":2,"message":"'PerformanceResourceTiming' is not defined.","line":85,"column":27,"nodeType":"Identifier","messageId":"undef","endLine":85,"endColumn":52},{"ruleId":"no-undef","severity":2,"message":"'PerformanceEntry' is not defined.","line":96,"column":67,"nodeType":"Identifier","messageId":"undef","endLine":96,"endColumn":83}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Performance E2E Tests\n * \n * Tests:\n * - LCP < 2.5s (Largest Contentful Paint)\n * - CLS < 0.1 (Cumulative Layout Shift)\n * - FID < 100ms (First Input Delay) - approximated via TBT\n * - TBT < 200ms (Total Blocking Time)\n * - FCP < 1.8s (First Contentful Paint)\n * - TTFB < 600ms (Time to First Byte)\n * \n * @performance\n */\n\nimport { test, expect } from \"@playwright/test\";\nimport type { Page, CDPSession } from \"@playwright/test\";\n\ninterface PerformanceMetrics {\n  // Navigation Timing\n  ttfb: number;\n  fcp: number;\n  lcp: number;\n  domContentLoaded: number;\n  loadComplete: number;\n  \n  // Web Vitals\n  cls: number;\n  tbt: number;\n  \n  // Resource counts\n  requestCount: number;\n  totalTransferSize: number;\n}\n\n/**\n * Collect performance metrics using Chrome DevTools Protocol\n */\nasync function collectPerformanceMetrics(\n  page: Page,\n  cdpSession: CDPSession\n): Promise<PerformanceMetrics> {\n  // Get navigation timing\n  const navigationTiming = await page.evaluate(() => {\n    const nav = performance.getEntriesByType(\"navigation\")[0] as PerformanceNavigationTiming;\n    const paint = performance.getEntriesByType(\"paint\");\n    \n    const fcpEntry = paint.find((p) => p.name === \"first-contentful-paint\");\n    \n    // Get LCP if available\n    const lcpEntries = performance.getEntriesByType(\"largest-contentful-paint\") as PerformanceEntry[];\n    const lcp = lcpEntries.length > 0 ? lcpEntries[lcpEntries.length - 1].startTime : 0;\n\n    return {\n      ttfb: nav.responseStart - nav.startTime,\n      fcp: fcpEntry ? fcpEntry.startTime : 0,\n      lcp: lcp,\n      domContentLoaded: nav.domContentLoadedEventEnd - nav.startTime,\n      loadComplete: nav.loadEventEnd - nav.startTime,\n    };\n  });\n\n  // Get layout shift (CLS) - simplified measurement\n  const cls = await page.evaluate(() => {\n    let clsValue = 0;\n    const entries = performance.getEntriesByType(\"layout-shift\") as PerformanceEntry[];\n    entries.forEach((entry) => {\n      if (!(entry as any).hadRecentInput) {\n        clsValue += (entry as any).value;\n      }\n    });\n    return clsValue;\n  });\n\n  // Get resource metrics\n  const resourceMetrics = await cdpSession.send(\"Performance.getMetrics\");\n  const jsHeapSize = resourceMetrics.metrics.find(\n    (m) => m.name === \"JSHeapUsedSize\"\n  )?.value || 0;\n\n  // Count requests and calculate transfer size\n  const resources = await page.evaluate(() => {\n    return performance.getEntriesByType(\"resource\").map((r) => ({\n      name: r.name,\n      duration: r.duration,\n      transferSize: (r as PerformanceResourceTiming).transferSize || 0,\n    }));\n  });\n\n  const totalTransferSize = resources.reduce(\n    (sum, r) => sum + (r.transferSize || 0),\n    0\n  );\n\n  // Calculate TBT (Total Blocking Time) approximation\n  const tbt = await page.evaluate(() => {\n    const longTasks = performance.getEntriesByType(\"longtask\") as PerformanceEntry[];\n    // TBT is sum of durations over 50ms, minus 50ms for each\n    return longTasks.reduce((sum, task) => {\n      const durationOver50 = task.duration - 50;\n      return durationOver50 > 0 ? sum + durationOver50 : sum;\n    }, 0);\n  });\n\n  return {\n    ...navigationTiming,\n    cls,\n    tbt,\n    requestCount: resources.length,\n    totalTransferSize,\n  };\n}\n\ntest.describe(\"Performance Metrics @performance\", () => {\n  let cdpSession: CDPSession;\n\n  test.beforeEach(async ({ page }) => {\n    // Create CDP session for performance metrics\n    cdpSession = await page.context().newCDPSession(page);\n    await cdpSession.send(\"Performance.enable\");\n  });\n\n  test(\"landing page meets Core Web Vitals\", async ({ page }) => {\n    // Clear cache for consistent results\n    await page.context().clearCookies();\n    \n    // Navigate with timing\n    const startTime = Date.now();\n    await page.goto(\"/no\", { waitUntil: \"networkidle\" });\n    const loadTime = Date.now() - startTime;\n\n    // Wait for LCP to stabilize\n    await page.waitForTimeout(2000);\n\n    const metrics = await collectPerformanceMetrics(page, cdpSession);\n\n    console.log(\"Landing Page Performance Metrics:\");\n    console.log(`  TTFB: ${metrics.ttfb.toFixed(0)}ms`);\n    console.log(`  FCP: ${metrics.fcp.toFixed(0)}ms`);\n    console.log(`  LCP: ${metrics.lcp.toFixed(0)}ms`);\n    console.log(`  CLS: ${metrics.cls.toFixed(3)}`);\n    console.log(`  TBT: ${metrics.tbt.toFixed(0)}ms`);\n    console.log(`  DOM Content Loaded: ${metrics.domContentLoaded.toFixed(0)}ms`);\n    console.log(`  Load Complete: ${metrics.loadComplete.toFixed(0)}ms`);\n    console.log(`  Request Count: ${metrics.requestCount}`);\n    console.log(`  Transfer Size: ${(metrics.totalTransferSize / 1024 / 1024).toFixed(2)}MB`);\n\n    // Core Web Vitals thresholds (Good)\n    expect(\n      metrics.lcp,\n      `LCP should be < 2500ms, got ${metrics.lcp.toFixed(0)}ms`\n    ).toBeLessThan(2500);\n\n    expect(\n      metrics.cls,\n      `CLS should be < 0.1, got ${metrics.cls.toFixed(3)}`\n    ).toBeLessThan(0.1);\n\n    expect(\n      metrics.ttfb,\n      `TTFB should be < 600ms, got ${metrics.ttfb.toFixed(0)}ms`\n    ).toBeLessThan(600);\n\n    // Additional thresholds\n    expect(\n      metrics.fcp,\n      `FCP should be < 1800ms, got ${metrics.fcp.toFixed(0)}ms`\n    ).toBeLessThan(1800);\n\n    // TBT threshold (approximation)\n    expect(\n      metrics.tbt,\n      `TBT should be < 200ms, got ${metrics.tbt.toFixed(0)}ms`\n    ).toBeLessThan(200);\n  });\n\n  test(\"pricing page performance\", async ({ page }) => {\n    await page.context().clearCookies();\n    \n    await page.goto(\"/no/priser\", { waitUntil: \"networkidle\" });\n    await page.waitForTimeout(1000);\n\n    const metrics = await collectPerformanceMetrics(page, cdpSession);\n\n    console.log(\"Pricing Page Performance Metrics:\");\n    console.log(`  LCP: ${metrics.lcp.toFixed(0)}ms`);\n    console.log(`  CLS: ${metrics.cls.toFixed(3)}`);\n    console.log(`  TTFB: ${metrics.ttfb.toFixed(0)}ms`);\n\n    expect(metrics.lcp).toBeLessThan(2500);\n    expect(metrics.cls).toBeLessThan(0.1);\n  });\n\n  test(\"login page performance\", async ({ page }) => {\n    await page.context().clearCookies();\n    \n    await page.goto(\"/no/innlogging\", { waitUntil: \"networkidle\" });\n    await page.waitForTimeout(1000);\n\n    const metrics = await collectPerformanceMetrics(page, cdpSession);\n\n    console.log(\"Login Page Performance Metrics:\");\n    console.log(`  LCP: ${metrics.lcp.toFixed(0)}ms`);\n    console.log(`  CLS: ${metrics.cls.toFixed(3)}`);\n    console.log(`  TTFB: ${metrics.ttfb.toFixed(0)}ms`);\n\n    expect(metrics.lcp).toBeLessThan(2500);\n    expect(metrics.cls).toBeLessThan(0.1);\n  });\n\n  test(\"page load time is acceptable\", async ({ page }) => {\n    const startTime = Date.now();\n    \n    await page.goto(\"/no\", { \n      waitUntil: \"domcontentloaded\",\n      timeout: 30000 \n    });\n    \n    const domContentLoadedTime = Date.now() - startTime;\n    \n    await page.waitForLoadState(\"networkidle\", { timeout: 30000 });\n    const fullLoadTime = Date.now() - startTime;\n\n    console.log(`DOM Content Loaded: ${domContentLoadedTime}ms`);\n    console.log(`Full Load: ${fullLoadTime}ms`);\n\n    expect(domContentLoadedTime).toBeLessThan(3000);\n    expect(fullLoadTime).toBeLessThan(6000);\n  });\n\n  test(\"no excessive JavaScript execution\", async ({ page }) => {\n    await page.goto(\"/no\", { waitUntil: \"networkidle\" });\n    \n    // Check for long tasks\n    const longTasks = await page.evaluate(() => {\n      return performance.getEntriesByType(\"longtask\").map((t) => ({\n        duration: t.duration,\n        startTime: t.startTime,\n      }));\n    });\n\n    console.log(`Found ${longTasks.length} long tasks`);\n    \n    // Should have minimal long tasks\n    expect(longTasks.length).toBeLessThan(10);\n\n    // No individual task should be extremely long\n    for (const task of longTasks) {\n      expect(task.duration).toBeLessThan(200);\n    }\n  });\n\n  test(\"resource loading is optimized\", async ({ page }) => {\n    const requests: Array<{ url: string; type: string; size: number }> = [];\n    \n    page.on(\"response\", async (response) => {\n      const url = response.url();\n      const type = response.headers()[\"content-type\"] || \"unknown\";\n      \n      try {\n        const body = await response.body();\n        requests.push({\n          url: url.slice(0, 100), // Truncate for logging\n          type: type.split(\";\")[0],\n          size: body?.length || 0,\n        });\n      } catch {\n        // Some responses may not have accessible body\n      }\n    });\n\n    await page.goto(\"/no\", { waitUntil: \"networkidle\" });\n\n    // Count by type\n    const jsRequests = requests.filter((r) => r.type.includes(\"javascript\"));\n    const cssRequests = requests.filter((r) => r.type.includes(\"css\"));\n    const imageRequests = requests.filter((r) => r.type.includes(\"image\"));\n\n    console.log(`JS requests: ${jsRequests.length}`);\n    console.log(`CSS requests: ${cssRequests.length}`);\n    console.log(`Image requests: ${imageRequests.length}`);\n    console.log(`Total requests: ${requests.length}`);\n\n    // Basic sanity checks\n    expect(jsRequests.length).toBeGreaterThan(0);\n    expect(requests.length).toBeLessThan(100); // Sanity limit\n  });\n\n  test(\"images are lazy loaded\", async ({ page }) => {\n    await page.goto(\"/no\", { waitUntil: \"domcontentloaded\" });\n\n    const images = await page.locator(\"img\").all();\n    let lazyLoadedCount = 0;\n\n    for (const img of images) {\n      const loading = await img.getAttribute(\"loading\");\n      if (loading === \"lazy\") {\n        lazyLoadedCount++;\n      }\n    }\n\n    console.log(`${lazyLoadedCount}/${images.length} images have loading=\"lazy\"`);\n\n    // Most images below the fold should be lazy loaded\n    if (images.length > 5) {\n      expect(lazyLoadedCount).toBeGreaterThan(images.length * 0.3);\n    }\n  });\n});\n\ntest.describe(\"Performance - Repeat Views @performance\", () => {\n  test(\"repeat view is faster (caching)\", async ({ page }) => {\n    // First view\n    const firstViewStart = Date.now();\n    await page.goto(\"/no\", { waitUntil: \"networkidle\" });\n    const firstViewTime = Date.now() - firstViewStart;\n\n    // Repeat view\n    const repeatViewStart = Date.now();\n    await page.goto(\"/no\", { waitUntil: \"networkidle\" });\n    const repeatViewTime = Date.now() - repeatViewStart;\n\n    console.log(`First view: ${firstViewTime}ms`);\n    console.log(`Repeat view: ${repeatViewTime}ms`);\n\n    // Repeat view should be faster (at least not significantly slower)\n    expect(repeatViewTime).toBeLessThan(firstViewTime * 1.5);\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/regression/authenticated-route-audit.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/regression/paper-trading.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/responsive/mobile-landing.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/smoke/final-launch.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/e2e/smoke/health.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErro