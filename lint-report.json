":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/notifications/NotificationBell.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/notifications/PushNotificationToggle.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/onboarding/InteractiveOnboardingWizard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/onboarding/OnboardingCompletion.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/onboarding/OnboardingFlow.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/onboarding/RiskDisclaimer.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/onboarding/SpeedOnboarding.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/onboarding/Step1StrategySelection.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/onboarding/Step2Countdown.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/onboarding/TradeExampleCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/onboarding/constants.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/components/onboarding/types.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/components/paper-trading/PaperTradingList.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/paper-trading/PaperTradingPageClient.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/paper-trading/PaperTradingSessionDetail.tsx","messages":[{"ruleId":"jsx-a11y/click-events-have-key-events","severity":1,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":491,"column":19,"nodeType":"JSXOpeningElement","endLine":496,"endColumn":20},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":1,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":491,"column":19,"nodeType":"JSXOpeningElement","endLine":496,"endColumn":20}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useCallback, useEffect, useState } from \"react\";\nimport Link from \"next/link\";\nimport { useRouter } from \"next/navigation\";\nimport { useTranslations } from \"next-intl\";\nimport { hrefWithLocale } from \"@/i18n/href-with-locale\";\nimport { BRAND } from \"@/lib/design/tokens\";\nimport {\n  PremiumTradingHero,\n  PremiumTradingShell,\n} from \"@/components/trading/PremiumTradingLayout\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport {\n  Dialog,\n  DialogContent,\n  DialogHeader,\n  DialogTitle,\n} from \"@/components/ui/dialog\";\nimport {\n  ArrowLeft,\n  Pause,\n  Play,\n  Square,\n  TrendingUp,\n  TrendingDown,\n  Wallet,\n  Trash2,\n  Info,\n} from \"lucide-react\";\nimport { toast } from \"sonner\";\nimport { createClient } from \"@/lib/supabase/client\";\nimport { canUseAutoTradingNow } from \"@/types/subscription\";\nimport { normalizeTier } from \"@/lib/pricing/tiers\";\n\ninterface TradingSession {\n  id: string;\n  mode: \"paper\" | \"live\";\n  status: \"active\" | \"paused\" | \"stopped\" | \"crashed\";\n  trading_pair: string;\n  strategy_id: string;\n  current_capital_nok: number;\n  starting_capital_nok: number;\n  total_pnl: number;\n  winning_trades: number;\n  total_trades: number;\n  created_at: string;\n}\n\n/** DB / API shape (quantity + realized_pnl); legacy UI used amount/profit_loss */\ninterface Trade {\n  id: string;\n  side: \"buy\" | \"sell\";\n  quantity?: number;\n  amount?: number;\n  price: number;\n  realized_pnl?: number | null;\n  profit_loss?: number | null;\n  total_value?: number | null;\n  created_at: string;\n  strategy_signal?: string | null;\n  trading_pair?: string | null;\n  status?: string | null;\n  fee?: number | null;\n  order_type?: string | null;\n}\n\nfunction tradeQuantity(t: Trade): number {\n  const q = t.quantity ?? t.amount;\n  return typeof q === \"number\" && Number.isFinite(q) ? q : 0;\n}\n\nfunction tradePnl(t: Trade): number | null {\n  const v = t.realized_pnl ?? t.profit_loss;\n  if (v == null || !Number.isFinite(Number(v))) return null;\n  return Number(v);\n}\n\ninterface PaperTradingSessionDetailProps {\n  session: TradingSession;\n  trades: Trade[];\n  locale: string;\n  /** For client-side tier-gate: ved åpning av live-session uten ?mode=live */\n  userTier?: string;\n  trialStartedAt?: string | null;\n}\n\nexport function PaperTradingSessionDetail({\n  session: initialSession,\n  trades: initialTrades,\n  locale,\n  userTier,\n  trialStartedAt,\n}: PaperTradingSessionDetailProps) {\n  const t = useTranslations(\"paperTrading\");\n  const router = useRouter();\n  const supabase = createClient();\n\n  const [session, setSession] = useState<TradingSession>(initialSession);\n  const [trades, setTrades] = useState<Trade[]>(initialTrades);\n  const [loading, setLoading] = useState(false);\n  const [selectedTrade, setSelectedTrade] = useState<Trade | null>(null);\n  const [deletingId, setDeletingId] = useState<string | null>(null);\n\n  const handleDeleteTrade = async (tradeId: string, e: React.MouseEvent) => {\n    e.stopPropagation();\n    if (!confirm(\"Slette denne traden? Dette kan ikke angres.\")) return;\n    setDeletingId(tradeId);\n    try {\n      const res = await fetch(`/api/paper-trading/trades/${tradeId}`, { method: \"DELETE\" });\n      if (res.ok) {\n        setTrades((prev) => prev.filter((t) => t.id !== tradeId));\n        if (selectedTrade?.id === tradeId) setSelectedTrade(null);\n        toast.success(\"Trade slettet\");\n      } else {\n        const d = await res.json();\n        toast.error(d?.error ?? \"Kunne ikke slette traden\");\n      }\n    } catch {\n      toast.error(\"Nettverksfeil — prøv igjen\");\n    } finally {\n      setDeletingId(null);\n    }\n  };\n\n  const refetchTrades = useCallback(async () => {\n    const { data, error } = await supabase\n      .from(\"trades\")\n      .select(\n        \"id, side, quantity, price, realized_pnl, created_at, total_value, executed_at, strategy_signal, trading_pair, status, fee, order_type\",\n      )\n      .eq(\"session_id\", session.id)\n      .order(\"executed_at\", { ascending: false })\n      .limit(100);\n\n    if (error) {\n      console.error(\"[PaperTradingSessionDetail] trades refetch:\", error);\n      return;\n    }\n    if (!data) return;\n\n    setTrades(\n      data.map((row) => ({\n        id: row.id,\n        side: row.side as \"buy\" | \"sell\",\n        quantity: Number(row.quantity),\n        price: Number(row.price),\n        realized_pnl: row.realized_pnl,\n        total_value: row.total_value ?? undefined,\n        created_at: row.executed_at ?? row.created_at,\n        strategy_signal: (row as Record<string, unknown>).strategy_signal as string | null,\n        trading_pair: (row as Record<string, unknown>).trading_pair as string | null,\n        status: (row as Record<string, unknown>).status as string | null,\n        fee: (row as Record<string, unknown>).fee as number | null,\n        order_type: (row as Record<string, unknown>).order_type as string | null,\n      })),\n    );\n  }, [session.id, supabase]);\n\n  /** Mot utdatert RSC-cache og manglende realtime: hent ferske handler ved mount + når fanen blir synlig. */\n  useEffect(() => {\n    void refetchTrades();\n  }, [refetchTrades]);\n\n  useEffect(() => {\n    const onVis = () => {\n      if (document.visibilityState === \"visible\") void refetchTrades();\n    };\n    document.addEventListener(\"visibilitychange\", onVis);\n    return () => document.removeEventListener(\"visibilitychange\", onVis);\n  }, [refetchTrades]);\n\n  // Client-side tier-gate: live-session uten ?mode=live — redirect til priser hvis ikke tilgang\n  useEffect(() => {\n    if (initialSession.mode !== \"live\" || !userTier) return;\n    const tier = normalizeTier(userTier);\n    if (!canUseAutoTradingNow(tier, trialStartedAt ?? null)) {\n      router.replace(`/${locale}/priser?upgrade=true`);\n    }\n  }, [initialSession.mode, userTier, trialStartedAt, locale, router]);\n\n  // Realtime subscription for trades\n  useEffect(() => {\n    const channel = supabase\n      .channel(`session-${session.id}`)\n      .on(\n        \"postgres_changes\",\n        {\n          event: \"INSERT\",\n          schema: \"public\",\n          table: \"trades\",\n          filter: `session_id=eq.${session.id}`,\n        },\n        (payload) => {\n          const row = payload.new as Record<string, unknown>;\n          const mapped: Trade = {\n            id: String(row.id),\n            side: row.side as \"buy\" | \"sell\",\n            quantity: Number(row.quantity),\n            price: Number(row.price),\n            realized_pnl:\n              row.realized_pnl != null ? Number(row.realized_pnl) : null,\n            total_value:\n              row.total_value != null ? Number(row.total_value) : undefined,\n            created_at: String(row.executed_at ?? row.created_at ?? \"\"),\n            strategy_signal: row.strategy_signal != null ? String(row.strategy_signal) : null,\n            trading_pair: row.trading_pair != null ? String(row.trading_pair) : null,\n            status: row.status != null ? String(row.status) : null,\n            fee: row.fee != null ? Number(row.fee) : null,\n            order_type: row.order_type != null ? String(row.order_type) : null,\n          };\n          setTrades((prev) => {\n            if (prev.some((t) => t.id === mapped.id)) return prev;\n            return [mapped, ...prev];\n          });\n        },\n      )\n      .on(\n        \"postgres_changes\",\n        {\n          event: \"UPDATE\",\n          schema: \"public\",\n          table: \"trading_sessions\",\n          filter: `id=eq.${session.id}`,\n        },\n        (payload) => {\n          setSession(payload.new as TradingSession);\n        },\n      )\n      .subscribe();\n\n    return () => {\n      supabase.removeChannel(channel);\n    };\n  }, [session.id, supabase]);\n\n  const handleStatusChange = async (\n    newStatus: \"active\" | \"paused\" | \"stopped\",\n  ) => {\n    setLoading(true);\n    try {\n      const response = await fetch(\n        `/api/trading-sessions/${session.id}/status`,\n        {\n          method: \"PATCH\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({ status: newStatus }),\n        },\n      );\n\n      if (!response.ok) throw new Error(\"Failed to update status\");\n\n      const data = await response.json();\n      setSession(data.session);\n\n      if (newStatus === \"stopped\") {\n        router.push(hrefWithLocale(locale, \"/paper-trading\"));\n      }\n    } catch (err) {\n      console.error(\"Failed to change status:\", err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const pnlPercent = session.starting_capital_nok\n    ? ((session.current_capital_nok - session.starting_capital_nok) /\n        session.starting_capital_nok) *\n      100\n    : 0;\n  const isProfitable = pnlPercent >= 0;\n  const winRate =\n    session.total_trades > 0\n      ? Math.round((session.winning_trades / session.total_trades) * 100)\n      : 0;\n\n  const getStatusBadge = (status: string) => {\n    switch (status) {\n      case \"active\":\n        return <Badge className=\"bg-green-500\">{t(\"active\")}</Badge>;\n      case \"paused\":\n        return <Badge variant=\"secondary\">{t(\"paused\")}</Badge>;\n      case \"stopped\":\n        return <Badge variant=\"outline\">{t(\"stopped\")}</Badge>;\n      case \"crashed\":\n        return <Badge variant=\"destructive\">{t(\"crashed\")}</Badge>;\n      default:\n        return <Badge variant=\"outline\">{status}</Badge>;\n    }\n  };\n\n  const isLive = session.mode === \"live\";\n\n  const startedLabel = new Date(session.created_at).toLocaleDateString(\n    locale === \"no\" ? \"nb-NO\" : \"en-US\",\n    { day: \"numeric\", month: \"short\", year: \"numeric\" },\n  );\n\n  return (\n    <PremiumTradingShell>\n      <Link\n        href={`${hrefWithLocale(locale, \"/paper-trading\")}?view=sessions`}\n        className={`inline-flex items-center gap-1.5 text-sm font-medium ${BRAND.link}`}\n      >\n        <ArrowLeft className=\"w-4 h-4\" />\n        {t(\"sessionDetail.backToHub\")}\n      </Link>\n\n      <PremiumTradingHero\n        eyebrow={\n          isLive\n            ? t(\"sessionDetail.eyebrowLive\")\n            : t(\"sessionDetail.eyebrowPaper\")\n        }\n        title={session.trading_pair}\n        subtitle={t(\"sessionDetail.startedOn\", { date: startedLabel })}\n        chips={getStatusBadge(session.status)}\n      />\n\n      {/* Tydelig UX: modus-banner (paper = merke #0052FF, live = rød) */}\n      <div\n        className={\n          isLive\n            ? \"rounded-xl bg-red-500/15 border border-red-500/20 dark:border-red-500/30 px-4 py-3 flex items-center justify-center gap-2\"\n            : \"rounded-xl bg-[#0052FF]/10 border border-[#0052FF]/20 dark:border-[#0052FF]/30 px-4 py-3 flex items-center justify-center gap-2\"\n        }\n      >\n        <Wallet\n          className={\n            isLive\n              ? \"w-5 h-5 text-red-600 dark:text-red-400 shrink-0\"\n              : \"w-5 h-5 text-[#0052FF] dark:text-[#3d7aff] shrink-0\"\n          }\n          aria-hidden\n        />\n        <p\n          className={\n            isLive\n              ? \"text-red-800 dark:text-red-200 text-sm font-medium\"\n              : \"text-[#0047E0] dark:text-[#3d7aff] text-sm font-medium\"\n          }\n        >\n          {isLive\n            ? locale === \"no\"\n              ? \"🔴 Live — Ekte penger. Handel med omhu.\"\n              : \"🔴 Live — Real money. Trade carefully.\"\n            : t(\"contextBanner\")}\n        </p>\n      </div>\n\n      {/* Stats Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        <Card>\n          <CardHeader className=\"pb-2\">\n            <CardTitle className=\"text-sm font-medium text-slate-600 dark:text-slate-400\">\n              {t(\"capital\")}\n            </CardTitle>\n          </CardHeader>\n          <CardContent>\n            <div className=\"flex items-baseline gap-2\">\n              <span className=\"text-2xl font-bold text-slate-900 dark:text-white\">\n                {session.current_capital_nok.toLocaleString(\"nb-NO\")} kr\n              </span>\n              <span\n                className={`text-sm font-medium ${\n                  isProfitable ? \"text-green-600\" : \"text-red-600\"\n                }`}\n              >\n                {isProfitable ? \"+\" : \"\"}\n                {pnlPercent.toFixed(1)}%\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-500 mt-1\">\n              {t(\"startCapital\")}:{\" \"}\n              {session.starting_capital_nok.toLocaleString(\"nb-NO\")} kr\n            </p>\n          </CardContent>\n        </Card>\n\n        <Card>\n          <CardHeader className=\"pb-2\">\n            <CardTitle className=\"text-sm font-medium text-slate-600 dark:text-slate-400\">\n              {t(\"winRate\")}\n            </CardTitle>\n          </CardHeader>\n          <CardContent>\n            <div className=\"flex items-baseline gap-2\">\n              <span className=\"text-2xl font-bold text-slate-900 dark:text-white\">\n                {winRate}%\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-500 mt-1\">\n              {session.winning_trades}/{session.total_trades}{\" \"}\n              {t(\"trades\").toLowerCase()}\n            </p>\n          </CardContent>\n        </Card>\n\n        <Card>\n          <CardHeader className=\"pb-2\">\n            <CardTitle className=\"text-sm font-medium text-slate-600 dark:text-slate-400\">\n              P&L\n            </CardTitle>\n          </CardHeader>\n          <CardContent>\n            <div className=\"flex items-baseline gap-2\">\n              <span\n                className={`text-2xl font-bold ${\n                  isProfitable ? \"text-green-600\" : \"text-red-600\"\n                }`}\n              >\n                {isProfitable ? \"+\" : \"\"}\n                {session.total_pnl?.toLocaleString(\"nb-NO\") || 0} kr\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-500 mt-1\">\n              {t(\"total\")} {t(\"trades\").toLowerCase()}: {session.total_trades}\n            </p>\n          </CardContent>\n        </Card>\n      </div>\n\n      {/* Actions */}\n      {session.status !== \"stopped\" && (\n        <div className=\"flex gap-2\">\n          {session.status === \"active\" ? (\n            <Button\n              variant=\"outline\"\n              onClick={() => handleStatusChange(\"paused\")}\n              disabled={loading}\n              className=\"gap-2\"\n            >\n              <Pause className=\"w-4 h-4\" />\n              {t(\"pauseBot\")}\n            </Button>\n          ) : (\n            <Button\n              variant=\"outline\"\n              onClick={() => handleStatusChange(\"active\")}\n              disabled={loading}\n              className=\"gap-2\"\n            >\n              <Play className=\"w-4 h-4\" />\n              {t(\"resume\")}\n            </Button>\n          )}\n          <Button\n            variant=\"destructive\"\n            onClick={() => handleStatusChange(\"stopped\")}\n            disabled={loading}\n            className=\"gap-2\"\n          >\n            <Square className=\"w-4 h-4\" />\n            {t(\"stopSession\")}\n          </Button>\n        </div>\n      )}\n\n      {/* Trades List */}\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"flex items-center gap-2\">\n            {t(\"trades\")}\n            <span className=\"text-xs font-normal text-slate-400 dark:text-slate-500 ml-1\">\n              — klikk for detaljer\n            </span>\n          </CardTitle>\n        </CardHeader>\n        <CardContent>\n          {trades.length === 0 ? (\n            <div className=\"text-center py-8 text-slate-500\">\n              {t(\"noTrades\")}\n            </div>\n          ) : (\n            <div className=\"space-y-2\">\n              {trades.map((trade) => {\n                const qty = tradeQuantity(trade);\n                const pnl = tradePnl(trade);\n                const isTradeProfitable = pnl != null ? pnl >= 0 : true;\n                const baseSymbol = (trade.trading_pair ?? session.trading_pair).split(\"/\")[0] ?? \"\";\n                const nok =\n                  trade.total_value != null &&\n                  Number.isFinite(trade.total_value)\n                    ? trade.total_value\n                    : null;\n                const isDeleting = deletingId === trade.id;\n\n                return (\n                  <div\n                    key={trade.id}\n                    data-testid=\"paper-session-trade-row\"\n                    onClick={() => setSelectedTrade(trade)}\n                    className=\"flex items-center justify-between p-3 bg-slate-50 dark:bg-slate-800 rounded-lg cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-700/70 transition-colors\"\n                  >\n                    <div className=\"flex items-center gap-3 flex-wrap min-w-0\">\n                      <Badge\n                        variant={trade.side === \"buy\" ? \"default\" : \"secondary\"}\n                      >\n                        {trade.side === \"buy\" ? t(\"buy\") : t(\"sell\")}\n                      </Badge>\n                      <span className=\"text-slate-900 dark:text-white\">\n                        {qty.toFixed(6)} {baseSymbol}\n                      </span>\n                      <span className=\"text-slate-500\">@</span>\n                      <span className=\"text-slate-900 dark:text-white\">\n                        {trade.price.toLocaleString(\"nb-NO\", {\n                          maximumFractionDigits: 2,\n                        })}{\" \"}\n                        USDT\n                      </span>\n                      {nok != null && (\n                        <span className=\"text-slate-500 text-sm\">\n                          (~{nok.toLocaleString(\"nb-NO\", { maximumFractionDigits: 0 })} kr)\n                        </span>\n                      )}\n                      {trade.strategy_signal ? (\n                        <span className=\"text-xs text-slate-500 dark:text-slate-400 italic truncate max-w-[160px]\">\n                          {trade.strategy_signal}\n                        </span>\n                      ) : null}\n                    </div>\n                    <div className=\"flex items-center gap-2 shrink-0\">\n                      {pnl != null && (\n                        <span\n                          className={`text-sm font-medium ${\n                            isTradeProfitable ? \"text-green-600\" : \"text-red-600\"\n                          }`}\n                        >\n                          {isTradeProfitable ? \"+\" : \"\"}\n                          {pnl.toLocaleString(\"nb-NO\")} kr\n                        </span>\n                      )}\n                      {pnl != null &&\n                        (isTradeProfitable ? (\n                          <TrendingUp className=\"w-4 h-4 text-green-600\" />\n                        ) : (\n                          <TrendingDown className=\"w-4 h-4 text-red-600\" />\n                        ))}\n                      <Info className=\"w-3.5 h-3.5 text-slate-400 ml-1\" aria-hidden />\n                      {session.mode === \"paper\" && (\n                        <button\n                          onClick={(e) => handleDeleteTrade(trade.id, e)}\n                          disabled={isDeleting}\n                          title=\"Slett trade\"\n                          className=\"ml-1 p-1 rounded hover:bg-red-100 dark:hover:bg-red-900/30 text-slate-400 hover:text-red-600 dark:hover:text-red-400 transition-colors disabled:opacity-40\"\n                        >\n                          {isDeleting ? (\n                            <span className=\"text-xs\">...</span>\n                          ) : (\n                            <Trash2 className=\"w-3.5 h-3.5\" />\n                          )}\n                        </button>\n                      )}\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          )}\n        </CardContent>\n      </Card>\n\n      {/* Trade detalj-modal */}\n      <Dialog open={!!selectedTrade} onOpenChange={(o) => { if (!o) setSelectedTrade(null); }}>\n        <DialogContent className=\"max-w-md\">\n          <DialogHeader>\n            <DialogTitle className=\"flex items-center gap-2\">\n              <Badge variant={selectedTrade?.side === \"buy\" ? \"default\" : \"secondary\"}>\n                {selectedTrade?.side === \"buy\" ? t(\"buy\") : t(\"sell\")}\n              </Badge>\n              Trade-detaljer\n            </DialogTitle>\n          </DialogHeader>\n          {selectedTrade && (() => {\n            const qty = tradeQuantity(selectedTrade);\n            const pnl = tradePnl(selectedTrade);\n            const pair = selectedTrade.trading_pair ?? session.trading_pair;\n            const rows: [string, string][] = [\n              [\"Par\", pair],\n              [\"Retning\", selectedTrade.side === \"buy\" ? \"Kjøp\" : \"Salg\"],\n              [\"Ordretype\", selectedTrade.order_type ?? \"market\"],\n              [\"Antall\", qty.toFixed(8)],\n              [\"Pris\", `${selectedTrade.price.toLocaleString(\"nb-NO\", { maximumFractionDigits: 2 })} USDT`],\n              [\"Verdi\", selectedTrade.total_value != null ? `${Number(selectedTrade.total_value).toLocaleString(\"nb-NO\", { maximumFractionDigits: 0 })} kr` : \"—\"],\n              [\"Gebyr\", selectedTrade.fee != null ? `${Number(selectedTrade.fee).toLocaleString(\"nb-NO\")} kr` : \"0 kr\"],\n              [\"P&L\", pnl != null ? `${pnl >= 0 ? \"+\" : \"\"}${pnl.toLocaleString(\"nb-NO\")} kr` : \"—\"],\n              [\"Status\", selectedTrade.status ?? \"filled\"],\n              [\"Tidspunkt\", new Date(selectedTrade.created_at).toLocaleString(\"nb-NO\")],\n            ];\n            return (\n              <div className=\"space-y-3 pt-2\">\n                <dl className=\"grid grid-cols-2 gap-x-4 gap-y-2 text-sm\">\n                  {rows.map(([label, value]) => (\n                    <>\n                      <dt key={`l-${label}`} className=\"text-slate-500 dark:text-slate-400\">{label}</dt>\n                      <dd key={`v-${label}`} className=\"text-slate-900 dark:text-white font-medium text-right\">{value}</dd>\n                    </>\n                  ))}\n                </dl>\n                {selectedTrade.strategy_signal && (\n                  <div className=\"mt-3 p-3 bg-slate-50 dark:bg-slate-800 rounded-lg\">\n                    <p className=\"text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1\">Signal</p>\n                    <p className=\"text-sm text-slate-700 dark:text-slate-300\">{selectedTrade.strategy_signal}</p>\n                  </div>\n                )}\n                {session.mode === \"paper\" && (\n                  <Button\n                    variant=\"destructive\"\n                    size=\"sm\"\n                    className=\"w-full mt-2 gap-2\"\n                    disabled={deletingId === selectedTrade.id}\n                    onClick={(e) => handleDeleteTrade(selectedTrade.id, e)}\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                    Slett trade\n                  </Button>\n                )}\n              </div>\n            );\n          })()}\n        </DialogContent>\n      </Dialog>\n    </PremiumTradingShell>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/components/paper-trading/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/components/payment/PaymentMethodSelector.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx