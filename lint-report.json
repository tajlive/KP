edRules":[]},{"filePath":"/Users/taj/klarpakke/src/lib/ai/providers.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/lib/ai/sentiment-analyzer.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/lib/ai/sentiment-service.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/lib/ai/sentiment-service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/lib/analytics.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/lib/api-auth.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/lib/api-client.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":218,"column":56,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":218,"endColumn":59,"fix":{"range":[6284,6287],"text":"unknown"},"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6284,6287],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6284,6287],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":1,"source":"/**\n * API v1 Client\n * \n * Consolidated API client for Klarpakke API v1 endpoints.\n * Replaces scattered API calls with a unified, type-safe client.\n * \n * Migration from legacy endpoints:\n * - /api/trading/* → /api/v1/trading/*\n * - /api/paper-trading/* → /api/v1/trading/*?mode=paper\n * - /api/webhooks/* → /api/v1/webhooks/*\n * - /api/cron/* → /api/v1/cron/*\n * - /api/notifications/* → /api/v1/notifications/*\n */\n\n// Trading mode type\ntype TradingMode = \"live\" | \"paper\";\n\n// Base configuration\nconst API_VERSION = process.env.NEXT_PUBLIC_API_VERSION || \"v1\";\nconst API_BASE = `/api/${API_VERSION}`;\n\n// Endpoint definitions\nexport const endpoints = {\n  trading: `${API_BASE}/trading`,\n  webhooks: `${API_BASE}/webhooks`,\n  cron: `${API_BASE}/cron`,\n  notifications: `${API_BASE}/notifications`,\n  // Legacy endpoints (kept for backwards compatibility during transition)\n  legacy: {\n    stripeWebhook: \"/api/webhooks/stripe\", // Keep original for signature verification\n  },\n} as const;\n\n// ============================================================================\n// Trading API\n// ============================================================================\n\n/**\n * Build trading endpoint URL with optional paper mode\n */\nexport function getTradingEndpoint(\n  action: string,\n  mode: TradingMode = \"live\"\n): string {\n  const url = new URL(`${endpoints.trading}/${action}`, window.location.origin);\n  if (mode === \"paper\") {\n    url.searchParams.set(\"mode\", \"paper\");\n  }\n  return url.toString();\n}\n\ninterface ExecuteTradeRequest {\n  symbol: string;\n  side: \"BUY\" | \"SELL\";\n  quantity: number;\n  type?: \"MARKET\" | \"LIMIT\";\n  price?: number;\n}\n\ninterface ExecuteTradeResponse {\n  success: boolean;\n  tradeId?: string;\n  error?: string;\n  executedPrice?: number;\n  executedQuantity?: number;\n}\n\n/**\n * Execute a trade (live or paper)\n */\nexport async function executeTrade(\n  data: ExecuteTradeRequest,\n  mode: TradingMode = \"live\"\n): Promise<ExecuteTradeResponse> {\n  const response = await fetch(getTradingEndpoint(\"execute\", mode), {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify(data),\n  });\n\n  if (!response.ok) {\n    const error = await response.json().catch(() => ({ error: \"Unknown error\" }));\n    throw new Error(error.error || `Trade failed: ${response.status}`);\n  }\n\n  return response.json();\n}\n\n/**\n * Get current trading mode for user\n */\nexport async function getTradingMode(): Promise<{ mode: TradingMode }> {\n  const response = await fetch(getTradingEndpoint(\"mode\", \"live\"));\n  if (!response.ok) throw new Error(\"Failed to get trading mode\");\n  return response.json();\n}\n\n/**\n * Set trading mode\n */\nexport async function setTradingMode(mode: TradingMode): Promise<void> {\n  const response = await fetch(getTradingEndpoint(\"mode\", \"live\"), {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ mode }),\n  });\n  if (!response.ok) throw new Error(\"Failed to set trading mode\");\n}\n\n/**\n * Get order book depth\n */\nexport async function getOrderBookDepth(\n  symbol: string\n): Promise<{ bids: [number, number][]; asks: [number, number][] }> {\n  const url = new URL(`${endpoints.trading}/depth`, window.location.origin);\n  url.searchParams.set(\"symbol\", symbol);\n\n  const response = await fetch(url.toString());\n  if (!response.ok) throw new Error(\"Failed to get order book\");\n  return response.json();\n}\n\n/**\n * Get current price for symbol\n */\nexport async function getCurrentPrice(symbol: string): Promise<{ price: number; change24h: number }> {\n  const url = new URL(`${endpoints.trading}/price`, window.location.origin);\n  url.searchParams.set(\"symbol\", symbol);\n\n  const response = await fetch(url.toString());\n  if (!response.ok) throw new Error(\"Failed to get price\");\n  return response.json();\n}\n\n// ============================================================================\n// Notifications API\n// ============================================================================\n\ninterface PushSubscription {\n  endpoint: string;\n  keys: {\n    p256dh: string;\n    auth: string;\n  };\n}\n\n/**\n * Subscribe to push notifications\n */\nexport async function subscribeToNotifications(\n  subscription: PushSubscription,\n  channel: string = \"default\"\n): Promise<{ success: boolean }> {\n  const response = await fetch(`${endpoints.notifications}/subscribe`, {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ subscription, channel }),\n  });\n\n  if (!response.ok) throw new Error(\"Failed to subscribe\");\n  return response.json();\n}\n\n/**\n * Unsubscribe from push notifications\n */\nexport async function unsubscribeFromNotifications(\n  channel: string = \"default\"\n): Promise<{ success: boolean }> {\n  const response = await fetch(`${endpoints.notifications}/unsubscribe`, {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ channel }),\n  });\n\n  if (!response.ok) throw new Error(\"Failed to unsubscribe\");\n  return response.json();\n}\n\n/**\n * Get notification subscription status\n */\nexport async function getNotificationStatus(): Promise<{\n  subscribed: boolean;\n  channels: string[];\n}> {\n  const response = await fetch(`${endpoints.notifications}/status`);\n  if (!response.ok) throw new Error(\"Failed to get status\");\n  return response.json();\n}\n\n// ============================================================================\n// Webhooks (Info only - webhooks are server-side)\n// ============================================================================\n\n/**\n * Get webhook provider info\n */\nexport async function getWebhookInfo(\n  provider: \"stripe\" | \"resend\" | \"github\"\n): Promise<{ provider: string; events: string[] }> {\n  const response = await fetch(`${endpoints.webhooks}/${provider}`);\n  if (!response.ok) throw new Error(\"Failed to get webhook info\");\n  return response.json();\n}\n\n// ============================================================================\n// Cron (Admin only)\n// ============================================================================\n\n/**\n * Trigger a cron job manually (requires admin/CRON_SECRET)\n */\nexport async function triggerCronJob(\n  job: string,\n  secret: string\n): Promise<{ ok: boolean; duration_ms: number; result: any }> {\n  const response = await fetch(`${endpoints.cron}/${job}`, {\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      Authorization: `Bearer ${secret}`,\n    },\n  });\n\n  if (!response.ok) {\n    const error = await response.json().catch(() => ({ error: \"Unknown error\" }));\n    throw new Error(error.error || `Cron job failed: ${response.status}`);\n  }\n\n  return response.json();\n}\n\n/**\n * Get cron job info\n */\nexport async function getCronJobInfo(job: string): Promise<{\n  job: string;\n  status: string;\n  description: string;\n}> {\n  const response = await fetch(`${endpoints.cron}/${job}`);\n  if (!response.ok) throw new Error(\"Failed to get cron info\");\n  return response.json();\n}\n\n// ============================================================================\n// Legacy API (for gradual migration)\n// ============================================================================\n\n/**\n * @deprecated Use executeTrade from api-client instead\n */\nexport async function legacyExecutePaperTrade(data: ExecuteTradeRequest) {\n  console.warn(\"[DEPRECATED] Using legacy paper trading endpoint\");\n  return executeTrade(data, \"paper\");\n}\n\n/**\n * @deprecated Use executeTrade from api-client instead  \n */\nexport async function legacyExecuteLiveTrade(data: ExecuteTradeRequest) {\n  console.warn(\"[DEPRECATED] Using legacy live trading endpoint\");\n  return executeTrade(data, \"live\");\n}\n\n// ============================================================================\n// Error handling\n// ============================================================================\n\nexport class ApiError extends Error {\n  constructor(\n    message: string,\n    public statusCode: number,\n    public response?: Response\n  ) {\n    super(message);\n    this.name = \"ApiError\";\n  }\n}\n\n/**\n * Generic API fetch wrapper with error handling\n */\nexport async function apiFetch<T>(\n  endpoint: string,\n  options: RequestInit = {}\n): Promise<T> {\n  const response = await fetch(endpoint, {\n    ...options,\n    headers: {\n      \"Content-Type\": \"application/json\",\n      ...options.headers,\n    },\n  });\n\n  if (!response.ok) {\n    const error = await response.json().catch(() => ({ error: \"Unknown error\" }));\n    throw new ApiError(\n      error.error || `API error: ${response.status}`,\n      response.status,\n      response\n    );\n  }\n\n  return response.json();\n}\n\n// Export default for convenience\nexport default {\n  endpoints,\n  executeTrade,\n  getTradingMode,\n  setTradingMode,\n  getOrderBookDepth,\n  getCurrentPrice,\n  subscribeToNotifications,\n  unsubscribeFromNotifications,\n  getNotificationStatus,\n  triggerCronJob,\n  getCronJobInfo,\n};\n","usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/lib/api-request-context.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/lib/api-response.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount"