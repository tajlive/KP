,"severity":1,"message":"Unexpected any. Specify a different type.","line":226,"column":55,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":226,"endColumn":58,"fix":{"range":[6491,6494],"text":"unknown"},"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6491,6494],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6491,6494],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":287,"column":42,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":287,"endColumn":45,"fix":{"range":[7976,7979],"text":"unknown"},"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[7976,7979],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[7976,7979],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":298,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":298,"endColumn":43,"fix":{"range":[8327,8330],"text":"unknown"},"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8327,8330],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8327,8330],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":10,"fixableErrorCount":0,"fixableWarningCount":10,"source":"/**\n * API v1: Notifications Consolidated Endpoint\n * \n * Consolidates notification operations under /api/v1/notifications/[action]\n */\n\nimport { createServerClient } from \"@/lib/supabase/server\";\nimport { NextRequest, NextResponse } from \"next/server\";\nimport webpush from \"web-push\";\n\nconst NOTIFICATION_ACTIONS = [\"send\", \"subscribe\", \"unsubscribe\", \"status\"] as const;\ntype NotificationAction = (typeof NOTIFICATION_ACTIONS)[number];\n\nfunction isValidAction(action: string): action is NotificationAction {\n  return NOTIFICATION_ACTIONS.includes(action as NotificationAction);\n}\n\n// Configure web-push with VAPID keys (lazy initialization)\nlet webpushInitialized = false;\n\nfunction initWebPush() {\n  if (webpushInitialized) return true;\n  \n  const VAPID_PUBLIC_KEY = process.env.NEXT_PUBLIC_VAPID_PUBLIC_KEY;\n  const VAPID_PRIVATE_KEY = process.env.VAPID_PRIVATE_KEY;\n  \n  if (VAPID_PUBLIC_KEY && VAPID_PRIVATE_KEY) {\n    try {\n      webpush.setVapidDetails(\n        \"mailto:admin@klarpakke.no\",\n        VAPID_PUBLIC_KEY,\n        VAPID_PRIVATE_KEY\n      );\n      webpushInitialized = true;\n      return true;\n    } catch (error) {\n      console.error(\"[v1/notifications] Failed to initialize web-push:\", error);\n      return false;\n    }\n  }\n  return false;\n}\n\nexport async function POST(\n  request: NextRequest,\n  { params }: { params: Promise<{ action: string }> }\n) {\n  try {\n    const { action } = await params;\n    \n    if (!isValidAction(action)) {\n      return NextResponse.json(\n        { error: \"Unknown action\", validActions: NOTIFICATION_ACTIONS },\n        { status: 400 }\n      );\n    }\n\n    const supabase = await createServerClient();\n    const body = await request.json().catch(() => ({}));\n\n    // Verify auth for sensitive operations\n    const { data: { user } } = await supabase.auth.getUser();\n\n    switch (action) {\n      case \"send\":\n        // Admin-only: requires CRON_SECRET or admin role\n        return handleSendNotification(request, supabase, body);\n      case \"subscribe\":\n        if (!user) return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n        return handleSubscribe(supabase, body, user.id);\n      case \"unsubscribe\":\n        if (!user) return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n        return handleUnsubscribe(supabase, body, user.id);\n      default:\n        return NextResponse.json(\n          { error: \"Action not supported for POST\" },\n          { status: 405 }\n        );\n    }\n  } catch (error) {\n    console.error(`[v1/notifications/${(await params).action}]`, error);\n    return NextResponse.json(\n      { error: \"Internal server error\" },\n      { status: 500 }\n    );\n  }\n}\n\nasync function handleSendNotification(\n  request: NextRequest,\n  supabase: any,\n  body: any\n) {\n  try {\n    // Initialize web-push if possible\n    const canSendPush = initWebPush();\n    \n    // Verify admin/CRON auth\n    const authHeader = request.headers.get(\"authorization\");\n    const isAdmin = authHeader === `Bearer ${process.env.CRON_SECRET}`;\n    \n    if (!isAdmin) {\n      // Check if user has admin role\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) {\n        return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n      }\n      \n      const { data: profile } = await supabase\n        .from(\"profiles\")\n        .select(\"role\")\n        .eq(\"id\", user.id)\n        .single();\n        \n      if (profile?.role !== \"admin\") {\n        return NextResponse.json({ error: \"Forbidden\" }, { status: 403 });\n      }\n    }\n\n    const { title, body: messageBody, icon, url, userIds, broadcast } = body;\n    \n    if (!title || !messageBody) {\n      return NextResponse.json(\n        { error: \"Title and body required\" },\n        { status: 400 }\n      );\n    }\n\n    // Get subscriptions\n    let subscriptions;\n    if (broadcast) {\n      const { data } = await supabase.from(\"push_subscriptions\").select(\"*\");\n      subscriptions = data || [];\n    } else if (userIds && userIds.length > 0) {\n      const { data } = await supabase\n        .from(\"push_subscriptions\")\n        .select(\"*\")\n        .in(\"user_id\", userIds);\n      subscriptions = data || [];\n    } else {\n      return NextResponse.json(\n        { error: \"userIds or broadcast required\" },\n        { status: 400 }\n      );\n    }\n\n    // Send notifications (if web-push is available)\n    if (!canSendPush) {\n      return NextResponse.json({\n        success: false,\n        error: \"Push notifications not configured (VAPID keys missing)\",\n        queued: subscriptions.length,\n      }, { status: 503 });\n    }\n\n    const results = await Promise.allSettled(\n      subscriptions.map(async (sub: any) => {\n        try {\n          await webpush.sendNotification(\n            sub.subscription,\n            JSON.stringify({ title, body: messageBody, icon, url })\n          );\n          return { success: true, userId: sub.user_id };\n        } catch (error) {\n          console.error(`[notifications/send] Failed for ${sub.user_id}`, error);\n          return { success: false, userId: sub.user_id, error: String(error) };\n        }\n      })\n    );\n\n    const sent = results.filter(r => r.status === \"fulfilled\" && (r.value as any).success).length;\n    const failed = results.length - sent;\n\n    return NextResponse.json({\n      success: true,\n      sent,\n      failed,\n      total: subscriptions.length,\n    });\n  } catch (error) {\n    console.error(\"[v1/notifications/send]\", error);\n    return NextResponse.json(\n      { error: \"Send notification failed\" },\n      { status: 500 }\n    );\n  }\n}\n\nasync function handleSubscribe(supabase: any, body: any, userId: string) {\n  try {\n    const { subscription, channel = \"default\" } = body;\n    \n    if (!subscription?.endpoint) {\n      return NextResponse.json(\n        { error: \"Invalid subscription data\" },\n        { status: 400 }\n      );\n    }\n\n    const { data, error } = await supabase\n      .from(\"push_subscriptions\")\n      .upsert({\n        user_id: userId,\n        channel,\n        subscription,\n        updated_at: new Date().toISOString(),\n      }, { onConflict: \"user_id,channel\" })\n      .select()\n      .single();\n\n    if (error) throw error;\n\n    return NextResponse.json({\n      success: true,\n      subscription: data,\n    });\n  } catch (error) {\n    console.error(\"[v1/notifications/subscribe]\", error);\n    return NextResponse.json(\n      { error: \"Subscribe failed\" },\n      { status: 500 }\n    );\n  }\n}\n\nasync function handleUnsubscribe(supabase: any, body: any, userId: string) {\n  try {\n    const { channel = \"default\" } = body;\n\n    const { error } = await supabase\n      .from(\"push_subscriptions\")\n      .delete()\n      .eq(\"user_id\", userId)\n      .eq(\"channel\", channel);\n\n    if (error) throw error;\n\n    return NextResponse.json({\n      success: true,\n      unsubscribed: true,\n    });\n  } catch (error) {\n    console.error(\"[v1/notifications/unsubscribe]\", error);\n    return NextResponse.json(\n      { error: \"Unsubscribe failed\" },\n      { status: 500 }\n    );\n  }\n}\n\nexport async function GET(\n  request: NextRequest,\n  { params }: { params: Promise<{ action: string }> }\n) {\n  try {\n    const { action } = await params;\n    \n    if (!isValidAction(action)) {\n      return NextResponse.json(\n        { error: \"Unknown action\" },\n        { status: 400 }\n      );\n    }\n\n    const supabase = await createServerClient();\n    const { data: { user } } = await supabase.auth.getUser();\n\n    switch (action) {\n      case \"status\":\n        if (!user) return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n        return handleGetStatus(supabase, user.id);\n      default:\n        return NextResponse.json(\n          { error: \"Action not supported for GET\" },\n          { status: 405 }\n        );\n    }\n  } catch (error) {\n    console.error(`[v1/notifications/GET]`, error);\n    return NextResponse.json(\n      { error: \"Internal server error\" },\n      { status: 500 }\n    );\n  }\n}\n\nasync function handleGetStatus(supabase: any, userId: string) {\n  try {\n    const { data: subscriptions, error } = await supabase\n      .from(\"push_subscriptions\")\n      .select(\"channel, updated_at\")\n      .eq(\"user_id\", userId);\n\n    if (error) throw error;\n\n    return NextResponse.json({\n      subscribed: subscriptions && subscriptions.length > 0,\n      channels: subscriptions?.map((s: any) => s.channel) || [],\n      lastUpdated: subscriptions?.[0]?.updated_at,\n    });\n  } catch (error) {\n    console.error(\"[v1/notifications/status]\", error);\n    return NextResponse.json(\n      { error: \"Status check failed\" },\n      { status: 500 }\n    );\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/app/api/v1/trading/[action]/route.ts","messages":[],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":416,"column":55,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":416,"endColumn":58,"fix":{"range":[11887,11890],"text":"unknown"},"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[11887,11890],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[11887,11890],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}],"suppressions":[{"kind":"directive","justification":""}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":688,"column":60,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":688,"endColumn":63,"fix":{"range":[18615,18618],"text":"unknown"},"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[18615,18618],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[18615,18618],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}],"suppressions":[{"kind":"directive","justification":""}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":754,"column":42,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":754,"endColumn":45,"fix":{"range":[20401,20404],"text":"unknown"},"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20401,20404],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20401,20404],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/app/api/v1/webhooks/[provider]/route.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":101,"column":11,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":101,"endColumn":14,"fix":{"range":[2947,2950],"text":"unknown"},"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2947,2950],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2947,2950],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":1,"source":"/**\n * API v1: Webhooks Consolidated Endpoint\n * \n * Consolidates webhook handlers under /api/v1/webhooks/[provider]\n */\n\nimport { NextRequest, NextResponse } from \"next/server\";\nimport crypto from \"crypto\";\n\nconst WEBHOOK_PROVIDERS = [\"stripe\", \"resend\", \"github\"] as const;\ntype WebhookProvider = (typeof WEBHOOK_PROVIDERS)[number];\n\nfunction isValidProvider(provider: string): provider is WebhookProvider {\n  return WEBHOOK_PROVIDERS.includes(provider as WebhookProvider);\n}\n\nexport async function POST(\n  request: NextRequest,\n  { params }: { params: Promise<{ provider: string }> }\n) {\n  try {\n    const { provider } = await params;\n    \n    if (!isValidProvider(provider)) {\n      return NextResponse.json(\n        { error: \"Unknown provider\", validProviders: WEBHOOK_PROVIDERS },\n        { status: 400 }\n      );\n    }\n\n    const body = await request.text();\n    const headers = request.headers;\n\n    switch (provider) {\n      case \"stripe\":\n        return handleStripeWebhook(body, headers);\n      case \"resend\":\n        return handleResendWebhook(body, headers);\n      case \"github\":\n        return handleGitHubWebhook(body, headers);\n      default:\n        return NextResponse.json(\n          { error: \"Provider not implemented\" },\n          { status: 501 }\n        );\n    }\n  } catch (error) {\n    console.error(`[v1/webhooks/${(await params).provider}]`, error);\n    return NextResponse.json(\n      { error: \"Webhook processing failed\" },\n      { status: 500 }\n    );\n  }\n}\n\nasync function handleStripeWebhook(body: string, headers: Headers) {\n  try {\n    const signature = headers.get(\"stripe-signature\");\n    if (!signature) {\n      return NextResponse.json(\n        { error: \"Missing stripe-signature header\" },\n        { status: 400 }\n      );\n    }\n\n    // For Stripe, we keep the original endpoint to preserve signature verification\n    // This v1 endpoint acts as a proxy/alternative\n    return NextResponse.json(\n      { \n        message: \"Use /api/webhooks/stripe for Stripe webhooks (signature verification)\",\n        alternative: \"/api/v1/webhooks/stripe (for info only)\"\n      },\n      { status: 200 }\n    );\n  } catch (error) {\n    console.error(\"[v1/webhooks/stripe]\", error);\n    return NextResponse.json(\n      { error: \"Stripe webhook processing failed\" },\n      { status: 500 }\n    );\n  }\n}\n\nasync function handleResendWebhook(body: string, headers: Headers) {\n  try {\n    const signature = headers.get(\"resend-signature\") || headers.get(\"x-resend-signature\");\n    \n    // Delegate to existing resend handler\n    const { POST: existingHandler } = await import(\n      \"@/app/api/webhooks/resend/route\"\n    );\n    \n    // Create a proper NextRequest-like object\n    const mockRequest = new Request(\"http://localhost/api/webhooks/resend\", {\n      method: \"POST\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n        ...(signature ? { \"resend-signature\": signature } : {}),\n      },\n      body,\n    }) as any; // Type cast to avoid NextRequest strict check\n\n    return await existingHandler(mockRequest);\n  } catch (error) {\n    console.error(\"[v1/webhooks/resend]\", error);\n    return NextResponse.json(\n      { error: \"Resend webhook processing failed\" },\n      { status: 500 }\n    );\n  }\n}\n\nasync function handleGitHubWebhook(body: string, headers: Headers) {\n  try {\n    const signature = headers.get(\"x-hub-signature-256\");\n    const event = headers.get(\"x-github-event\");\n    \n    if (!signature || !event) {\n      return NextResponse.json(\n        { error: \"Missing required GitHub headers\" },\n        { status: 400 }\n      );\n    }\n\n    const secret = process.env.GITHUB_WEBHOOK_SECRET;\n    if (!secret) {\n      return NextResponse.json(\n        { error: \"Webhook not configured\" },\n        { status: 503 }\n      );\n    }\n\n    // Verify signature\n    const hmac = crypto.createHmac(\"sha256\", secret);\n    hmac.update(body);\n    const expectedSignature = `sha256=${hmac.digest(\"hex\")}`;\n\n    if (!crypto.timingSafeEqual(\n      Buffer.from(signature),\n      Buffer.from(expectedSignature)\n    )) {\n      return NextResponse.json(\n        { error: \"Invalid signature\" },\n        { status: 401 }\n      );\n    }\n\n    const payload = JSON.parse(body);\n    console.log(`[v1/webhooks/github] ${event} event`, {\n      repo: payload.repository?.full_name,\n      sender: payload.sender?.login,\n    });\n\n    return NextResponse.json({ received: true, event });\n  } catch (error) {\n    console.error(\"[v1/webhooks/github]\", error);\n    return NextResponse.json(\n      { error: \"GitHub webhook processing failed\" },\n      { status: 500 }\n    );\n  }\n}\n\nexport async function GET(\n  request: NextRequest,\n  { params }: { params: Promise<{ provider: string }> }\n) {\n  const { provider } = await params;\n  \n  if (!isValidProvider(provider)) {\n    return NextResponse.json(\n      { error: \"Unknown provider\" },\n      { status: 400 }\n    );\n  }\n\n  return NextResponse.json({\n    provider,\n    status: \"active\",\n    events: getSupportedEvents(provider),\n  });\n}\n\nfunction getSupportedEvents(provider: WebhookProvider): string[] {\n  switch (provider) {\n    case \"stripe\":\n      return [\"checkout.session.completed\", \"invoice.payment_succeeded\", \"customer.subscription.updated\"];\n    case \"resend\":\n      return [\"email.delivered\", \"email.opened\", \"email.bounced\"];\n    case \"github\":\n      return [\"push\", \"pull_request\", \"issues\"];\n    default:\n      return [];\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/app/api/webhooks/resend/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/app/api/webhooks/stripe/config.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/app/api/webhooks/stripe/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/app/auth/callback/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/taj/klarpakke/src/app/error.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/app/global-error.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Users/taj/klarpakke/src/app/layout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"jsx-a11y/label-has-for","replacedBy":["label-has-associated-control"]}]},{"filePath":"/Use