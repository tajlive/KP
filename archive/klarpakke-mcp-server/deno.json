{
  "name": "@klarpakke/mcp-server",
  "version": "1.0.0",
  "exports": "./src/index.ts",
  "nodeModulesDir": "auto",
  "tasks": {
    "start": "deno run --allow-all src/index.ts",
    "dev": "deno run --allow-all --watch src/index.ts",
    "check": "deno check src/index.ts"
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "imports": {
    "@modelcontextprotocol/sdk": "https://esm.sh/@modelcontextprotocol/sdk@1.0.4",
    "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2.39.7"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
