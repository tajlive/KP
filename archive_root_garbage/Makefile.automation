# Klarpakke - Full Automatisering Makefile
# Bruk: make -f Makefile.automation <target>

.PHONY: help setup test deploy monitor backup docs security clean

# Farger
BLUE := \033[36m
GREEN := \033[32m
YELLOW := \033[33m
RED := \033[31m
NC := \033[0m

help: ## Vis denne hjelpen
	@echo "$(BLUE)╔══════════════════════════════════════════════════════════════╗$(NC)"
	@echo "$(BLUE)║           🚀 KlarPakke Automatisering                        ║$(NC)"
	@echo "$(BLUE)╚══════════════════════════════════════════════════════════════╝$(NC)"
	@echo ""
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}'

# ═══════════════════════════════════════════════════════════════
# SETUP & ONBOARDING
# ═══════════════════════════════════════════════════════════════

setup: ## Full setup for nye utviklere
	@echo "$(BLUE)🔧 Setter opp utviklingsmiljø...$(NC)"
	@bash scripts/automation/dev-setup.sh

setup-mcp: ## Sett opp MCP automatisering
	@bash scripts/setup-mcp-automation.sh

setup-git: ## Konfigurer git hooks
	@bash scripts/automation/setup-git-hooks.sh

# ═══════════════════════════════════════════════════════════════
# TESTING & QA
# ═══════════════════════════════════════════════════════════════

test: ## Kjør alle tester
	@echo "$(BLUE)🧪 Kjører tester...$(NC)"
	@npm run test

test-e2e: ## Kjør E2E tester
	@echo "$(BLUE)🎭 Kjører Playwright E2E tester...$(NC)"
	@npx playwright test

test-e2e-ui: ## Kjør E2E tester med UI
	@npx playwright test --ui

test-coverage: ## Generer test coverage rapport
	@echo "$(BLUE)📊 Genererer coverage rapport...$(NC)"
	@npm run test:coverage
	@open coverage/index.html 2>/dev/null || echo "Åpne coverage/index.html for rapport"

lint: ## Lint kode
	@echo "$(BLUE)🔍 Linter kode...$(NC)"
	@npm run lint

lint-fix: ## Lint og fiks kode
	@echo "$(BLUE)🔧 Linter og fikser kode...$(NC)"
	@npm run lint -- --fix

types: ## Sjekk TypeScript typer
	@echo "$(BLUE)📘 Sjekker TypeScript...$(NC)"
	@npx tsc --noEmit

format: ## Formater kode
	@echo "$(BLUE)✨ Formatterer kode...$(NC)"
	@npx prettier --write "src/**/*.{ts,tsx,js,jsx,json,css,md}"

format-check: ## Sjekk formatering
	@npx prettier --check "src/**/*.{ts,tsx,js,jsx,json,css,md}"

qa: lint types test ## Full QA sjekk
	@echo "$(GREEN)✅ Alle QA sjekker passert!$(NC)"

# ═══════════════════════════════════════════════════════════════
# BUILD & DEPLOY
# ═══════════════════════════════════════════════════════════════

build: ## Build prosjektet
	@echo "$(BLUE)🔨 Bygger prosjekt...$(NC)"
	@npm run build

build-analyze: ## Build med bundle analyse
	@echo "$(BLUE)📦 Bygger med bundle analyse...$(NC)"
	@ANALYZE=true npm run build

deploy: ## Deploy til Vercel
	@echo "$(BLUE)🚀 Deployer til Vercel...$(NC)"
	@bash scripts/mcp-auto-deploy.sh

deploy-preview: ## Deploy preview til Vercel
	@echo "$(BLUE)👁️  Deployer preview...$(NC)"
	@npx vercel

deploy-prod: ## Deploy til production
	@echo "$(BLUE)🚀 Deployer til PRODUCTION...$(NC)"
	@npx vercel --prod

deploy-edge: ## Deploy Edge Functions
	@echo "$(BLUE)⚡ Deployer Edge Functions...$(NC)"
	@supabase functions deploy

# ═══════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════

db-migrate: ## Kjør database migrasjoner
	@echo "$(BLUE)🗄️  Kjører migrasjoner...$(NC)"
	@supabase db push

db-reset: ## Reset lokal database
	@echo "$(YELLOW)⚠️  Resetter lokal database...$(NC)"
	@supabase db reset

db-backup: ## Backup database
	@echo "$(BLUE)💾 Backup database...$(NC)"
	@bash scripts/automation/db-backup.sh

db-restore: ## Restore database fra backup
	@echo "$(YELLOW)⚠️  Restorer database...$(NC)"
	@bash scripts/automation/db-restore.sh

db-seed: ## Seed database med testdata
	@echo "$(BLUE)🌱 Seeder database...$(NC)"
	@supabase seed run

db-types: ## Generer TypeScript typer fra database
	@echo "$(BLUE)📘 Genererer database typer...$(NC)"
	@npx supabase gen types typescript --local > src/types/supabase.ts

# ═══════════════════════════════════════════════════════════════
# MONITORING & LOGS
# ═══════════════════════════════════════════════════════════════

logs: ## Se Vercel logs
	@echo "$(BLUE)📜 Henter Vercel logs...$(NC)"
	@npx vercel logs

logs-edge: ## Se Edge Function logs
	@echo "$(BLUE)⚡ Henter Edge Function logs...$(NC)"
	@supabase functions logs

logs-db: ## Se database logs
	@echo "$(BLUE)🗄️  Henter database logs...$(NC)"
	@supabase logs postgres

sentry: ## Se Sentry errors
	@echo "$(BLUE)🐛 Åpner Sentry...$(NC)"
	@open https://sentry.io/organizations/klarpakke/issues/

status: ## Sjekk system status
	@echo "$(BLUE)🔍 Sjekker system status...$(NC)"
	@bash scripts/mcp-status.sh

health: ## Health check
	@echo "$(BLUE)🏥 Health check...$(NC)"
	@curl -s https://www.klarpakke.no/api/health | jq . || echo "Health check failed"

# ═══════════════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════════════

security-scan: ## Kjør security scan
	@echo "$(BLUE)🔒 Scanner for sikkerhetsproblemer...$(NC)"
	@npm audit
	@bash scripts/automation/security-scan.sh

secrets-check: ## Sjekk for secrets i koden
	@echo "$(BLUE)🔍 Sjekker for secrets...$(NC)"
	@gitleaks detect --source . --verbose --redact

dependencies-update: ## Oppdater dependencies
	@echo "$(BLUE)📦 Oppdaterer dependencies...$(NC)"
	@npm update
	@npm outdated

dependencies-check: ## Sjekk for utdaterte dependencies
	@echo "$(BLUE)📋 Sjekker dependencies...$(NC)"
	@npm outdated

# ═══════════════════════════════════════════════════════════════
# DOKUMENTASJON
# ═══════════════════════════════════════════════════════════════

docs: ## Generer dokumentasjon
	@echo "$(BLUE)📚 Genererer dokumentasjon...$(NC)"
	@bash scripts/automation/generate-docs.sh

changelog: ## Generer changelog
	@echo "$(BLUE)📝 Genererer changelog...$(NC)"
	@bash scripts/automation/generate-changelog.sh

api-docs: ## Generer API dokumentasjon
	@echo "$(BLUE)📘 Genererer API docs...$(NC)"
	@bash scripts/automation/generate-api-docs.sh

# ═══════════════════════════════════════════════════════════════
# AI & AUTOMATISERING
# ═══════════════════════════════════════════════════════════════

ai-review: ## AI code review
	@echo "$(BLUE)🤖 Kjører AI code review...$(NC)"
	@bash scripts/automation/ai-code-review.sh

ai-docs: ## Generer dokumentasjon med AI
	@echo "$(BLUE)🤖 Genererer AI dokumentasjon...$(NC)"
	@bash scripts/automation/ai-generate-docs.sh

ai-test: ## Generer tester med AI
	@echo "$(BLUE)🤖 Genererer tester med AI...$(NC)"
	@bash scripts/automation/ai-generate-tests.sh

ai-commit: ## AI-generert commit melding
	@echo "$(BLUE)🤖 Lager commit melding...$(NC)"
	@bash scripts/automation/ai-commit.sh

# ═══════════════════════════════════════════════════════════════
# UTILITIES
# ═══════════════════════════════════════════════════════════════

clean: ## Rydd opp temp filer
	@echo "$(BLUE)🧹 Rydder opp...$(NC)"
	@rm -rf .next node_modules/.cache
	@rm -rf coverage/.nyc_output
	@echo "$(GREEN)✅ Opprydding fullført$(NC)"

clean-all: ## Rydd opp alt (inkludert node_modules)
	@echo "$(YELLOW)⚠️  Rydder opp ALLE filer...$(NC)"
	@rm -rf node_modules
	@rm -rf .next
	@rm -rf dist
	@rm -rf coverage
	@echo "$(GREEN)✅ Full opprydding fullført$(NC)"

install: ## Installer dependencies
	@echo "$(BLUE)📦 Installerer dependencies...$(NC)"
	@npm install

update: ## Oppdater alle tools og dependencies
	@echo "$(BLUE)🔄 Oppdaterer...$(NC)"
	@npm update
	@supabase --version
	@vercel --version

# ═══════════════════════════════════════════════════════════════
# SHORTCUTS
# ═══════════════════════════════════════════════════════════════

full-check: lint types test build ## Full sjekk før commit
	@echo "$(GREEN)✅ Full sjekk fullført!$(NC)"

quick-deploy: qa deploy ## Rask deploy (QA + Deploy)

ship-it: full-check deploy-prod ## SHIP IT! (Alt sjekk + Prod deploy)
	@echo "$(GREEN)🚀 SHIPPED TO PRODUCTION!$(NC)"

.DEFAULT_GOAL := help
