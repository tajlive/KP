# ============================================================
# KREVER BEKREFTELSE (destruktive/irreversible)
# ============================================================
# Disse KREVER alltid manuell bekreftelse uavhengig av denne filen:
#
# rm -rf /              # Sletting av systemfiler
# drop database         # Sletting av database
# rm -rf node_modules   # Sletting av avhengigheter (kan gjenskapes)
# git push --force      # Force push til git
# git reset --hard      # Hard reset
# sudo *                # Admin-operasjoner
# kill -9 1             # Drepe systemprosesser
# dd if=* of=*          # Disk-operasjoner
# mkfs.*                # Formatering
# ALTER TABLE DROP      # Database DDL
# DELETE FROM *         # Massesletting (uten WHERE)
# ============================================================

# Notis: Destruktive operasjoner logges alltid til kimi-security.log
