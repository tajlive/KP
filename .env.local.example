# =============================================================================
# KLARPAKKE ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (Required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://pskhryjzkobytnfwucrb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# -----------------------------------------------------------------------------
# SANITY CMS (NEW - Required for CMS)
# -----------------------------------------------------------------------------
# 1. Go to https://www.sanity.io/manage
# 2. Create new project
# 3. Copy project ID from dashboard
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-04-07

# For preview mode (server-side only)
# Get token from: https://www.sanity.io/manage/personal/project/YOUR_ID/api#tokens
SANITY_API_READ_TOKEN=your_read_token_here

# -----------------------------------------------------------------------------
# AI PROVIDERS (Optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here
MOONSHOT_API_KEY=your_moonshot_key_here

# Moonshot Kimi API key for K2.7 Code (recommended)
KIMI_API_KEY=your_kimi_api_key_here

# -----------------------------------------------------------------------------
# PAYMENTS (Optional - for live trading)
# -----------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# MONITORING (Optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# -----------------------------------------------------------------------------
# EXTERNAL APIs (Optional)
# -----------------------------------------------------------------------------
BINANCE_API_KEY=your_binance_key_here
BINANCE_SECRET_KEY=your_binance_secret_here
