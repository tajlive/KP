# ============================================================
# KLARPAKKE — .env.local mal
# Kopier til .env.local og fyll inn verdiene
# ALDRI commit .env.local til git!
#
# ── SUPABASE_SERVICE_ROLE_KEY (service_role JWT) ─────────────
# Kun på disse stedene — ALDRI i repo, issues, chat eller klientkode:
#   1) Lokal: denne filen kopiert til .env.local (gitignored)
#   2) Vercel: Project → Settings → Environment Variables (Production/Preview)
#   3) GitHub Actions: repo → Settings → Secrets → SUPABASE_SERVICE_ROLE_KEY
#      (brukes av E2E-workflow for create-test-users.js --from-env)
# Har nøkkelen vært eksponert offentlig: rotér i Supabase → Settings → API først.
#
# ADVARSEL: `npm run vercel:env` overskriver .env.local med Vercel Production.
# Ta backup først: cp .env.local .env.local.bak
# Hvis du trenger Development-miljø: npm run vercel:env:development
# (da MÅ NEXT_PUBLIC_SUPABASE_* være satt i Vercel → Development, ellers forsvinner de.)
# ============================================================

# ── SUPABASE ─────────────────────────────────────────────────
# https://supabase.com/dashboard/project/vuxbjlykgmzskxbclquf/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://vuxbjlykgmzskxbclquf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ACCESS_TOKEN=sbp_...  # For MCP-server
# Valgfri: Bearer for Edge Function klarpakke-mcp (Cursor ~/.cursor/mcp.json → klarpakke-remote-mcp)
# KLARPAKKE_MCP_TOKEN=

# ── DATABASE (psql direkte) ───────────────────────────────────
# https://supabase.com/dashboard/project/vuxbjlykgmzskxbclquf/settings/database
# Bruk Transaction pooler (port 6543) for applikasjonen
DATABASE_URL=postgresql://postgres.vuxbjlykgmzskxbclquf:[PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres
# Bruk Session pooler (port 5432) for migrasjoner
DATABASE_URL_MIGRATION=postgresql://postgres.vuxbjlykgmzskxbclquf:[PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# ── STRIPE ───────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
# ⚠️  ROTER NØKKELEN SOM LAY I mcp.json FØR DU BRUKER DENNE!
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...  # Bruk sk_ ikke rk_ for applikasjonen
STRIPE_WEBHOOK_SECRET=whsec_...

# ── GITHUB ───────────────────────────────────────────────────
# https://github.com/settings/tokens (PAT Classic, repo scope)
GITHUB_TOKEN=ghp_...

# ── LINEAR ───────────────────────────────────────────────────
# https://linear.app/settings/api
LINEAR_API_KEY=lin_api_...

# ── VERCEL ───────────────────────────────────────────────────
# https://vercel.com/account/tokens
VERCEL_TOKEN=...

# ── CLOUDFLARE (MCP/CLI, DNS, Pages) ─────────────────────────
# https://dash.cloudflare.com/profile/api-tokens (Zone Read, Zone DNS Edit, Account Read)
CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...   # Valgfritt; for account/pages uten auto-detect

# ── CURSOR (Cloud Agents API) ────────────────────────────────
# https://cursor.com/dashboard → Cloud Agents → API key (for cursor-api.mjs)
# CURSOR_API_KEY=...

# ── SENTRY ───────────────────────────────────────────────────
# https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=sntryu_...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# Lokalt next build: upload skippes når VERCEL ikke er satt (unngår plugin-feil).
# Tving upload fra maskin: SENTRY_UPLOAD_SOURCE_MAPS=true (+ gyldig SENTRY_AUTH_TOKEN).
# Tving av overalt: SENTRY_UPLOAD_SOURCE_MAPS=false

# ── RESEND ───────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_...

# ── ANALYTICS (Plausible) ─────────────────────────────────────
# https://plausible.io/sites (GDPR-compliant, ingen cookies)
# Plausible lastes via PlausibleScript.tsx (offisielt script); ingen npm-pakke
# Domain: klarpakke.no
# Ingen ekstra env-variabler nødvendig for Plausible

# ── OPENAI / AI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── GOOGLE AUTH ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# ── ADMIN ─────────────────────────────────────────────────────
# Kommaseparert liste med ekstra admin-e-poster (server). Slås sammen med innebygd fallback.
# Klient-side admin-layout bruker kun fallback; env-ekstra krever rolle=admin ELLER server-runde.
# ADMIN_EMAIL_ALLOWLIST=kollega@firma.no,annet@domene.no

# ── APP ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.klarpakke.no
NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_SITE_URL=https://www.klarpakke.no   # Admin cron-trigger, checkout success URL
# NEXT_PUBLIC_BASE_URL=https://www.klarpakke.no   # Stripe checkout

# ── CRON (Vercel Cron / beskyttede ruter) ─────────────────────
# Maskin-til-maskin: Bearer CRON_SECRET (ikke JWT). SoT: docs/CRON-SOURCE-OF-TRUTH.md
# Full oppsett: docs/FULL-AUTOMATION-PLAYBOOK.md
# Vercel: Settings → Environment Variables. Brukes av /api/cron/* og /api/admin/cron-trigger
CRON_SECRET=...
# CRON_API_KEY=...   # Valgfritt; /api/cron/auto-trade

# ── REDIS / CACHE (Upstash REST – @upstash/redis) ──────────────
# Anbefalt: Vercel → Integrations → Upstash Redis (REST URL + token).
# Fallback: gamle Vercel KV-variabler (samme REST-endepunkt etter migrering).
# UPSTASH_REDIS_REST_URL=...
# UPSTASH_REDIS_REST_TOKEN=...
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...

# ── ENCRYPTION (API-nøkler, Binance) ──────────────────────────
# 32-byte hex (64 tegn). Brukes i src/lib/crypto/encrypt-api-keys.ts
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Binance encrypt endpoint (egen secret valgfritt)
# BINANCE_ENCRYPTION_SECRET=...

# ── STRIPE PRISER (planer) ────────────────────────────────────
# Dashboard: Products → Prices → kopier price_xxx (én Price per valuta for samme plan).
# Beløp i kode: src/lib/pricing.config.ts (NOK/EUR/USD). Env overstyrer innebygde priceId.
# NOK: suffiks _NOK eller legacy uten suffiks (samme som _NOK).
# NEXT_PUBLIC_STRIPE_PRICE_BACHELOR_NOK=price_...
# NEXT_PUBLIC_STRIPE_PRICE_BACHELOR_EUR=price_...
# NEXT_PUBLIC_STRIPE_PRICE_BACHELOR_USD=price_...
# NEXT_PUBLIC_STRIPE_PRICE_MASTER_NOK=price_...   (eller NEXT_PUBLIC_STRIPE_PRICE_MASTER)
# NEXT_PUBLIC_STRIPE_PRICE_MASTER_EUR=price_...
# NEXT_PUBLIC_STRIPE_PRICE_MASTER_USD=price_...
# NEXT_PUBLIC_STRIPE_PRICE_PHD_NOK=price_...
# NEXT_PUBLIC_STRIPE_PRICE_PHD_EUR=price_...
# NEXT_PUBLIC_STRIPE_PRICE_PHD_USD=price_...
# NEXT_PUBLIC_STRIPE_PRICE_PROFESSOR_NOK=price_...
# NEXT_PUBLIC_STRIPE_PRICE_PROFESSOR_EUR=price_...
# NEXT_PUBLIC_STRIPE_PRICE_PROFESSOR_USD=price_...
# Legacy (én NOK-pris): NEXT_PUBLIC_STRIPE_PRICE_BACHELOR=price_... (tilsvarer _NOK)
#
# ── Valgfritt: eksplisitte live-ID-er (mars 2026) — samme som pricing.config.ts ──
# NEXT_PUBLIC_STRIPE_PRICE_BACHELOR_NOK=price_1T4QVJCGsVawsLofgt9uuOcU
# NEXT_PUBLIC_STRIPE_PRICE_BACHELOR_EUR=price_1TD5UECGsVawsLof3Zq0XC0N
# NEXT_PUBLIC_STRIPE_PRICE_BACHELOR_USD=price_1TD5UECGsVawsLofmqsT6zeV
# NEXT_PUBLIC_STRIPE_PRICE_MASTER_NOK=price_1T4QVKCGsVawsLofr8NPcL6g
# NEXT_PUBLIC_STRIPE_PRICE_MASTER_EUR=price_1TD5UECGsVawsLofd2IVqjqz
# NEXT_PUBLIC_STRIPE_PRICE_MASTER_USD=price_1TD5UECGsVawsLofRg6WfI78
# NEXT_PUBLIC_STRIPE_PRICE_PHD_NOK=price_1T4QVKCGsVawsLofz1US0uVZ
# NEXT_PUBLIC_STRIPE_PRICE_PHD_EUR=price_1TD5UHCGsVawsLofRydZEMDV
# NEXT_PUBLIC_STRIPE_PRICE_PHD_USD=price_1TD5UHCGsVawsLofVsnaqzju
# NEXT_PUBLIC_STRIPE_PRICE_PROFESSOR_NOK=price_1T4QVLCGsVawsLofgMEbOBJA
# NEXT_PUBLIC_STRIPE_PRICE_PROFESSOR_EUR=price_1TD5UHCGsVawsLofU8a1xR2R
# NEXT_PUBLIC_STRIPE_PRICE_PROFESSOR_USD=price_1TD5UHCGsVawsLof59k680pJ
# Årlig brukes ikke i checkout ennå; ID-er i docs/pricing/STRIPE-CHECKOUT-MULTI-CURRENCY.md
# NEXT_PUBLIC_STRIPE_STUDENT_PRICE_MONTHLY=... NEXT_PUBLIC_STRIPE_STUDENT_PRICE_ANNUAL=...
# NEXT_PUBLIC_STRIPE_MASTER_PRICE_MONTHLY=... _ANNUAL=...
# NEXT_PUBLIC_STRIPE_PROFESSOR_PRICE_MONTHLY=... _ANNUAL=...
# Se også lib/stripe-prices.ts for NEXT_PUBLIC_PRICE_* (kurser, VIP).

# ── VIPPS (betaling) ──────────────────────────────────────────
# VIPPS_CLIENT_ID=...
# VIPPS_CLIENT_SECRET=...
# VIPPS_SUBSCRIPTION_KEY=...
# VIPPS_MERCHANT_SERIAL_NUMBER=...
# VIPPS_BASE_URL=https://api.vipps.no

# ── BINANCE (server-side, valgfritt) ──────────────────────────
# BINANCE_API_KEY=... BINANCE_API_SECRET=...
# BINANCE_USE_TESTNET=true   # Dev/test

# ── AI (Perplexity, Kimi/Moonshot, NVIDIA, Huggingface) ───────
# PERPLEXITY_API_KEY=...
# MOONSHOT_API_KEY=... eller KIMI_API_KEY=...
# NVIDIA_API_KEY=... eller NVIDIA_NIM_API_KEY=...
# HUGGINGFACE_API_KEY=... eller NEXT_PUBLIC_HUGGINGFACE_API_KEY=...
# NEXT_PUBLIC_CF_AI_WORKER_URL=...   # Cloudflare Workers AI (cloudflare-inference)

# ── PUSH (Web Push) ───────────────────────────────────────────
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=...

# ── DEV / TEST ────────────────────────────────────────────────
# TEST_SECRET=... ALLOW_TEST_API=1   # Kun dev; /api/test/auth/login

# Full referanse: docs/ENV-MCP-CLI-API-AUDIT.md
