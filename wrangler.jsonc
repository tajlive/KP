    "NEXT_PUBLIC_APP_VERSION": "1.0.0",
    "NEXT_PUBLIC_PLAUSIBLE_DOMAIN": "klarpakke.no",
    "NEXT_PUBLIC_SANITY_API_VERSION": "2024-01-01",
