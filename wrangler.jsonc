{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klarpakke",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-16",
  "minify": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NEXT_PUBLIC_STRIPE_PRICE_BACHELOR": "price_1T4QVJCGsVawsLofgt9uuOcU",
    "NEXT_PUBLIC_STRIPE_PRICE_MASTER": "price_1T4QVKCGsVawsLofr8NPcL6g",
    "NEXT_PUBLIC_STRIPE_PRICE_PHD": "price_1T4QVKCGsVawsLofz1US0uVZ",
    "NEXT_PUBLIC_STRIPE_PRICE_PROFESSOR": "price_1T4QVLCGsVawsLofgMEbOBJA",
    "NEXT_PUBLIC_LIVE_TRADING_DOGFOOD": "true",
    "NEXT_PUBLIC_MONEY_GUARDRAILS": "true"
  },
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "klarpakke-tag-cache",
      "database_id": "f6ec4afc-03fc-4e5f-a87f-ee52fc0320c3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "next-inc-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "klarpakke"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "klarpakke-tasks",
        "binding": "KLARPAKKE_TASKS"
      }
    ],
    "consumers": [
      {
        "queue": "klarpakke-tasks"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "www.klarpakke.no/*",
      "zone_id": "328d7de7e8e48308fd4f9d760da5b18f"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.05
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.005
    }
  },
  "kv_namespaces": [
    {
      "binding": "KV_KLARPAKKE",
      "id": "36369d6957c14ef1a25e22dff65fdc79"
    },
    {
      "binding": "KV_KLARPAKKE_STAGING",
      "id": "707c647acb86464f8df2f949564734fc"
    }
  ],
  "build": {},
  "env": {
    "staging": {
      "name": "klarpakke-staging",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "staging.klarpakke.no/*",
          "zone_id": "328d7de7e8e48308fd4f9d760da5b18f"
        }
      ],
      "compatibility_date": "2026-07-16",
      "compatibility_flags": [
        "nodejs_compat"
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "head_sampling_rate": 0.01
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.001
        }
      },
      "kv_namespaces": [
        {
          "binding": "KV_KLARPAKKE",
          "id": "36369d6957c14ef1a25e22dff65fdc79"
        },
        {
          "binding": "KV_KLARPAKKE_STAGING",
          "id": "707c647acb86464f8df2f949564734fc"
        }
      ],
      "d1_databases": [
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "klarpakke-tag-cache",
          "database_id": "f6ec4afc-03fc-4e5f-a87f-ee52fc0320c3"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "next-inc-cache"
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "klarpakke-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "klarpakke-tasks",
            "binding": "KLARPAKKE_TASKS"
          }
        ],
        "consumers": [
          {
            "queue": "klarpakke-tasks"
          }
        ]
      },
      "ai": {
        "binding": "AI"
      },
      "vars": {
        "NEXT_PUBLIC_STRIPE_PRICE_BACHELOR": "price_1T4QVJCGsVawsLofgt9uuOcU",
        "NEXT_PUBLIC_STRIPE_PRICE_MASTER": "price_1T4QVKCGsVawsLofr8NPcL6g",
        "NEXT_PUBLIC_STRIPE_PRICE_PHD": "price_1T4QVKCGsVawsLofz1US0uVZ",
        "NEXT_PUBLIC_STRIPE_PRICE_PROFESSOR": "price_1T4QVLCGsVawsLofgMEbOBJA"
      }
    }
  }
}