#!/usr/bin/env bash
# Klarpakke pre-push — blokker push hvis noe feiler
set -e

echo "🔒 Klarpakke Pre-Push"

# 1. TypeScript
echo "  tsc..."
npx tsc --noEmit --pretty false 2>&1 | tail -3
echo "  ✅ tsc OK"

# 2. Unit tests (bare de raskeste)
echo "  vitest..."
npx vitest run --reporter=verbose 2>&1 | tail -1
echo "  ✅ tests OK"

# 3. Lint
echo "  lint..."
npx next lint --quiet 2>&1 | tail -1
echo "  ✅ lint OK"

echo "✅ Alt klart — push tillatt"
