#!/usr/bin/env sh
if [ -s "${HOME}/.nvm/nvm.sh" ]; then
  # shellcheck source=/dev/null
  . "${HOME}/.nvm/nvm.sh"
  nvm use 2>/dev/null || true
fi
export PATH="/opt/homebrew/bin:/usr/local/bin:${PATH}"

echo "🔍 Running pre-push quality gates..."

npm run lint:gate
npm run type-check
npm run test:unit

echo "✅ Pre-push checks passed."
