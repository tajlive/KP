#!/usr/bin/env bash
# Klarpakke pre-push hook
# Kjører tester lokalt FØR push — blokkerer hvis noe feiler.

set -e

echo "🚀 Klarpakke Pre-Push — sjekker..."

# Fast-fail: Sjekk kun de raskeste testene
echo "  ⚡ Rate limit test..."
npx vitest run src/middleware/rateLimit.test.ts --reporter=dot 2>&1 | tail -3

echo "  ⚡ TSC type-check..."
npx tsc --noEmit 2>&1 | head -5 || {
  echo "❌ TypeScript-feil — rett opp før push!"
  exit 1
}

echo "✅ Pre-push OK"
