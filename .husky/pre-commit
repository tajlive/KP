#!/bin/sh
# Klarpakke pre-commit gate — blokkerer commit ved TypeScript-feil
# Kjøres automatisk av git før hver commit

cd "$(git rev-parse --show-toplevel)" || exit 1

# ============================================================================
# Hjelpefunksjoner
# ============================================================================

# Sjekk om staged filer matcher et pattern
has_staged_in_path() {
  git diff --cached --name-only | grep -q "$1"
}

# ============================================================================
# 1. Auth-redirect guard (alltid)
# ============================================================================

echo "🔍 [0/8] Sjekker auth-redirect pattern..."
node scripts/verify-no-auth-redirects.mjs || exit 1

# ============================================================================
# 1. Secrets-sjekk (alltid)
# ============================================================================

echo "🔍 [1/8] Sjekker secrets i staged filer..."
bash scripts/check-secrets-staged.sh || exit 1

# ============================================================================
# 2. Migrasjonsvalidering (kun hvis supabase/migrations endres)
# ============================================================================

if has_staged_in_path "^supabase/migrations/"; then
  echo "🔍 [2/8] Migrasjonsvalidering (staged filer)..."
  node scripts/validate-migrations.mjs --staged || exit 1
else
  echo "⏭️  [2/8] Ingen migrasjonsendringer — skipper validering"
fi

# ============================================================================
# 2. AST/Type-verifisering for kritiske paths (kun hvis relevant)
# ============================================================================

CRITICAL_PATHS="src/lib/ai/sonar/ src/lib/trading/ src/app/api/signal/ scripts/"
NEEDS_AST_CHECK=false

for path in $CRITICAL_PATHS; do
  if has_staged_in_path "^$path"; then
    NEEDS_AST_CHECK=true
    echo "📁 Fant endringer i $path — trigger AST-verifisering"
  fi
done

if [ "$NEEDS_AST_CHECK" = true ]; then
  echo "🔍 [3/8] AST/type-verifisering (ts-morph)..."
  npm run verify:ts-ast 2>&1
  AST_EXIT=$?
  if [ $AST_EXIT -ne 0 ]; then
    echo ""
    echo "❌ AST-verifisering feilet! Commit blokkert."
    echo "   Fiks TypeScript-feilene over først."
    echo ""
    exit 1
  fi
else
  echo "⏭️  [3/8] Ingen kritiske paths endret — skipper AST-verifisering"
fi

# ============================================================================
# 3. Full TypeScript-sjekk (alltid)
# ============================================================================

echo "🔍 [4/8] TypeScript-sjekk (tsc --noEmit)..."
npx tsc --noEmit 2>&1
TSC_EXIT=$?
if [ $TSC_EXIT -ne 0 ]; then
  echo ""
  echo "❌ TypeScript-feil funnet! Commit blokkert."
  echo ""
  echo "  Raskt fix for Supabase .eq()-feil:"
  echo "    node scripts/guard-supabase-columns.mjs --fix"
  echo ""
  echo "  Generell TypeScript-feil:"
  echo "    npx tsc --noEmit   → finn og fiks manuelt"
  echo ""
  exit 1
fi

# ============================================================================
# 4. Supabase kolonne-guard (alltid)
# ============================================================================

echo "🔍 [5/8] Supabase kolonne-guard..."
node scripts/guard-supabase-columns.mjs
GUARD_EXIT=$?
if [ $GUARD_EXIT -ne 0 ]; then
  echo ""
  echo "❌ Supabase kolonne-feil! Commit blokkert."
  echo "   Kjør: node scripts/guard-supabase-columns.mjs --fix"
  exit 1
fi

# ============================================================================
# 4b. Browser-supabase guard (alltid) — KLA-auth
# ============================================================================

echo "🔍 [5b/8] Browser-supabase guard (KLA-auth)..."
node scripts/guard-browser-supabase.mjs || exit 1

# ============================================================================
# 4c. Service-role auth guard (alltid) — KLA-auth
# ============================================================================
# Blokkerer service-role createClient() + .auth.getUser() — mønsteret som
# la /api/klt/balance og /api/email/send nede i prod (evig 401).

echo "🔍 [5c/8] Service-role auth guard (KLA-auth)..."
node scripts/guard-service-role-auth.mjs || exit 1

# ============================================================================
# 5d. i18n-validering (kun hvis messages/ endres)
# ============================================================================

if has_staged_in_path "^messages/"; then
  echo "🔍 [5d/8] i18n-validering..."
  node scripts/validate-i18n.js || exit 1
else
  echo "⏭️  [5d/8] Ingen i18n-endringer — skipper validering"
fi

# ============================================================================
# 5e. E2E smoke-test (kun hvis kritiske UI-filer endres)
# ============================================================================

CRITICAL_UI_PATHS="src/features/trading/ src/features/dashboard/ src/app/\[locale\]/"
NEEDS_E2E=false

for path in $CRITICAL_UI_PATHS; do
  if has_staged_in_path "^$path"; then
    NEEDS_E2E=true
    echo "📁 Fant endringer i $path — kjører E2E smoke-test"
    break
  fi
done

if [ "$NEEDS_E2E" = true ]; then
  echo "🔍 [5e/8] E2E smoke-test (alle sider)..."
  npx playwright test e2e/smoke/all-pages.spec.ts --project=chromium --reporter=list 2>&1 | tail -5
  E2E_EXIT=$?
  if [ $E2E_EXIT -ne 0 ]; then
    echo ""
    echo "❌ E2E smoke-test feilet! Commit blokkert."
    echo "   Sjekk at alle sider laster uten krasj."
    echo ""
    exit 1
  fi
else
  echo "⏭️  [5e/8] Ingen kritiske UI-filer endret — skipper E2E"
fi

# ============================================================================
# 6. MemPalace Auto-Capture (valgfritt)
# ============================================================================

echo "🏛️  [6/8] MemPalace auto-capture..."
node scripts/mempalace-auto-capture.mjs

echo "✅ Pre-commit: Alt OK. Committer..."
exit 0
