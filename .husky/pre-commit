#!/bin/sh
# Klarpakke pre-commit gate — blokkerer commit ved TypeScript-feil
# Kjøres automatisk av git før hver commit

cd /Users/taj/klarpakke || exit 1

# ============================================================================
# Hjelpefunksjoner
# ============================================================================

# Sjekk om staged filer matcher et pattern
has_staged_in_path() {
  git diff --cached --name-only | grep -q "$1"
}

# ============================================================================
# 1. Secrets-sjekk (alltid)
# ============================================================================

echo "🔍 [1/6] Sjekker secrets i staged filer..."
bash scripts/check-secrets-staged.sh || exit 1

# ============================================================================
# 2. Migrasjonsvalidering (kun hvis supabase/migrations endres)
# ============================================================================

if has_staged_in_path "^supabase/migrations/"; then
  echo "🔍 [2/6] Migrasjonsvalidering (staged filer)..."
  node scripts/validate-migrations.mjs --staged || exit 1
else
  echo "⏭️  [2/6] Ingen migrasjonsendringer — skipper validering"
fi

# ============================================================================
# 2. AST/Type-verifisering for kritiske paths (kun hvis relevant)
# ============================================================================

CRITICAL_PATHS="src/lib/ai/sonar/ src/lib/trading/ src/app/api/signal/ scripts/"
NEEDS_AST_CHECK=false

for path in $CRITICAL_PATHS; do
  if has_staged_in_path "^$path"; then
    NEEDS_AST_CHECK=true
    echo "📁 Fant endringer i $path — trigger AST-verifisering"
  fi
done

if [ "$NEEDS_AST_CHECK" = true ]; then
  echo "🔍 [3/6] AST/type-verifisering (ts-morph)..."
  npm run verify:ts-ast 2>&1
  AST_EXIT=$?
  if [ $AST_EXIT -ne 0 ]; then
    echo ""
    echo "❌ AST-verifisering feilet! Commit blokkert."
    echo "   Fiks TypeScript-feilene over først."
    echo ""
    exit 1
  fi
else
  echo "⏭️  [3/6] Ingen kritiske paths endret — skipper AST-verifisering"
fi

# ============================================================================
# 3. Full TypeScript-sjekk (alltid)
# ============================================================================

echo "🔍 [4/6] TypeScript-sjekk (tsc --noEmit)..."
npx tsc --noEmit 2>&1
TSC_EXIT=$?
if [ $TSC_EXIT -ne 0 ]; then
  echo ""
  echo "❌ TypeScript-feil funnet! Commit blokkert."
  echo ""
  echo "  Raskt fix for Supabase .eq()-feil:"
  echo "    node scripts/guard-supabase-columns.mjs --fix"
  echo ""
  echo "  Generell TypeScript-feil:"
  echo "    npx tsc --noEmit   → finn og fiks manuelt"
  echo ""
  exit 1
fi

# ============================================================================
# 4. Supabase kolonne-guard (alltid)
# ============================================================================

echo "🔍 [5/6] Supabase kolonne-guard..."
node scripts/guard-supabase-columns.mjs
GUARD_EXIT=$?
if [ $GUARD_EXIT -ne 0 ]; then
  echo ""
  echo "❌ Supabase kolonne-feil! Commit blokkert."
  echo "   Kjør: node scripts/guard-supabase-columns.mjs --fix"
  exit 1
fi

# ============================================================================
# 5. MemPalace Auto-Capture (valgfritt)
# ============================================================================

echo "🏛️  [6/6] MemPalace auto-capture..."
node scripts/mempalace-auto-capture.mjs

echo "✅ Pre-commit: Alt OK. Committer..."
exit 0
