#!/bin/sh
# Supabase Column Guard - Pre-commit hook
# Sjekker for .eq("bad_column") feil før commit

cd /Users/taj/klarpakke || exit 1

echo "🔍 Sjekker for Supabase kolonne-feil..."

# Kjør guard-script
node scripts/guard-supabase-columns.mjs

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ Pre-commit sjekk feilet!"
    echo ""
    echo "For å fikse automatisk, kjør:"
    echo "  node scripts/guard-supabase-columns.mjs --fix"
    echo ""
    echo "Deretter stage endringene og commit på nytt."
    exit 1
fi

echo "✅ Supabase kolonne-sjekk fullført!"
exit 0
