# Required Kimi/Moonshot OAuth client
KIMI_OAUTH_CLIENT_ID=your-client-id
# Optional if the OAuth client is confidential:
KIMI_OAUTH_CLIENT_SECRET=

# Optional endpoint overrides
KIMI_OAUTH_DEVICE_ENDPOINT=https://platform.moonshot.cn/oauth/device
KIMI_OAUTH_TOKEN_ENDPOINT=https://platform.moonshot.cn/oauth/token
KIMI_OAUTH_SCOPE=openid profile

# Local bridge settings
# BRIDGE_API_KEY takes precedence; KIMI_OAUTH_BRIDGE_API_KEY is convenient for OMP.
KIMI_OAUTH_BRIDGE_API_KEY=replace-with-a-random-local-secret
KIMI_OAUTH_BRIDGE_PORT=8123
BRIDGE_LOG_LEVEL=info
